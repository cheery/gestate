# examples/gui/carry.ges — the notes editor's note hand, as reactors.
# `card:gui-is-difficult.md` §"The next slice: the notes editor's note
# hand".
#
#   python -m gestate.workbench examples/gui/carry.ges
#
# **A note is an instance, one per note the file says** — a bank, keyed
# by the note's place, so a note written into `tune.notes` by hand can
# be carried at once and one deleted is gone.  Each holds no copy of its
# note: the row is handed to it, and the file is the truth.
#
# **Press a note and carry it**, snapped to a sixteenth in time and a
# semitone in pitch; the file is written once, on the release, the
# note's own line rewritten in place.  **Press and let go** without
# moving, and the window says where the note is written.
#
# **Pull a note's end** to change its length, a sixteenth at a time and
# never under one — the end is a part of the note's picture of its own,
# `hold end`, so where it is is said once, where the note is drawn.
#
# **Sweep a band over empty roll** and every note it touches is
# selected; a press on empty roll clears it.  The selection is a
# **session document** — `selected`, held by the window in memory beside
# the piece and never saved into `tune.notes` — read and written through
# a lens like any document.

include "tune.notes"

levels : List Text
levels = "ppp" :: "pp" :: "p" :: "mp" :: "mf" :: "f" :: "ff" :: "fff" :: Nil

noteRel : Rel
noteRel = Rel "note"
    (Col "section" Word :: Col "bar" (AtLeast 1) :: Col "voice" Word :: Col "at" (AtLeast 0)
     :: Col "key" (Range 0 127) :: Col "len" (AtLeast 1) :: Col "vel" (OneOf levels) :: Nil)
    ("section" :: "bar" :: "voice" :: "at" :: "key" :: Nil)

#: A note selected, named by its place — the note's own key.
selRel : Rel
selRel = Rel "selected"
    (Col "section" Word :: Col "bar" (AtLeast 1) :: Col "voice" Word :: Col "at" (AtLeast 0)
     :: Col "key" (Range 0 127) :: Nil)
    ("section" :: "bar" :: "voice" :: "at" :: "key" :: Nil)

model : List Rel
model = noteRel :: selRel :: Nil

lines : List Line
lines = Line "note" Named ("section" :: "bar" :: "at" :: "len" :: "voice" :: "key" :: "vel" :: Nil) Nil
    :: Line "selected" Named ("section" :: "bar" :: "at" :: "voice" :: "key" :: Nil) Nil :: Nil

#: The kinds the window holds in memory, not in a file.
session : List Text
session = "selected" :: Nil

type NoteRow = $(rowType noteRel)
type Tune = Set NoteRow
type Pick = $(rowType selRel)
type Picks = Set Pick

tune : Sig Tune
tune = document "note"

picks : Sig Picks
picks = document "selected"

#: What the roll is handed: the notes and the selection, as one model.
type Model = (Tune, Picks)

both : Sig Model
both = !pairUp tune picks

pairUp : Tune -> Picks -> Model
pairUp t p = (t, p)

#: A bar of four beats, ninety-six ticks a beat, as `tune.notes` says.
span : Int
span = 384

tickOf : NoteRow -> Int
tickOf n = case n of
    (s, b, v, a, k, l, e) -> (b - 1) * span + a

#: The note's place as one number — what a press on it says.
noteKey : NoteRow -> Float
noteKey n = case n of
    (s, b, v, a, k, l, e) -> toFloat (tickOf n * 128 + k)

#: The note carried by a hand that moved `dx`, `dy` pixels: a sixteenth
#: in time per 12 pixels across, a semitone per 8 pixels up.
carried : NoteRow -> Int -> Int -> NoteRow
carried n dx dy = case n of
    (s, b, v, a, k, l, e) -> placed (s, v, k - floor (toFloat dy / 8.0 + 0.5), l, e)
        (tickOf n + 24 * floor (toFloat dx / 12.0 + 0.5))

placed : (Text, Text, Int, Int, Text) -> Int -> NoteRow
placed r t = case r of
    (s, v, k, l, e) -> (s, t / span + 1, v, t - (t / span) * span, k, l, e)

#: The note with its end pulled `dx` pixels: a sixteenth per 12 pixels,
#: as the carry snaps time, and never under one.
sized : NoteRow -> Int -> NoteRow
sized n dx = case n of
    (s, b, v, a, k, l, e) -> (s, b, v, a, k, max 24 (l + 24 * floor (toFloat dx / 12.0 + 0.5)), e)

#: What the note is, and the acts that put it somewhere else — its line
#: told the new place or length, or, where it was let go as it was
#: taken, its place said.
moving : NoteRow -> Lens Model NoteRow
moving n = Lens (s => n) (s r => case (noteKey r, lenOf r) == (noteKey n, lenOf n) of
    True -> Reveal "note" (keyAtoms n) :: Nil
    False -> MoveTo "note" (keyAtoms n) (rowAtoms r) :: Nil)

lenOf : NoteRow -> Int
lenOf n = case n of
    (s, b, v, a, k, l, e) -> l

keyAtoms : NoteRow -> List Atom
keyAtoms n = case n of
    (s, b, v, a, k, l, e) -> atoms (s, b, v, a, k)

rowAtoms : NoteRow -> List Atom
rowAtoms n = case n of
    (s, b, v, a, k, l, e) -> atoms ((s, b, v, a, k), (l, e))

whole : Lens Model Tune
whole = Lens (m => fst m) (m t => Nil)

pickOf : NoteRow -> Pick
pickOf n = case n of
    (s, b, v, a, k, l, e) -> (s, b, v, a, k)

#: Two picks the same note — by pairs, the tuples `Eq` has.
same : Pick -> Pick -> Bool
same p q = case (p, q) of
    ((s, b, v, a, k), (t, c, w, d, j)) -> ((s, b), ((v, a), k)) == ((t, c), ((w, d), j))

has : Pick -> List Pick -> Bool
has p ps = any (q => same p q) ps

#: Whether a note is selected — read, never written, by the note.
marked : NoteRow -> Lens Model Bool
marked n = Lens (m => has (pickOf n) (elems (snd m))) (m b => Nil)

#: The selection as a list, and the acts that make it say another one:
#: what it had and the new one has not, retracted; what the new one has
#: and it had not, asserted.  `put` sees the model for exactly this.
chosen : Lens Model (List Pick)
chosen = Lens (m => elems (snd m)) (m now => dropped (elems (snd m)) now ++ added (elems (snd m)) now)

dropped : List Pick -> List Pick -> List Act
dropped had now = foldr (p acts => unless (has p now) acts (retracting selRel p :: acts)) Nil had

added : List Pick -> List Pick -> List Act
added had now = foldr (p acts => unless (has p had) acts (asserting selRel p :: acts)) Nil now

#: `x` before `xs` when `b` holds.
adding : Bool -> a -> List a -> List a
adding b x xs = case b of
    True -> x :: xs
    False -> xs

unless : Bool -> a -> a -> a
unless b acts more = case b of
    True -> acts
    False -> more

#: The notes a band from (x0, y0) to (x, y) touches — any part of its
#: bar inside the band, Reaper's rule and today's.
swept : Tune -> Int -> Int -> Int -> Int -> List Pick
swept t x0 y0 x y = foldr (n ps => adding (touches n (min x0 x) (min y0 y) (max x0 x) (max y0 y)) (pickOf n) ps) Nil (elems t)

touches : NoteRow -> Int -> Int -> Int -> Int -> Bool
touches n bx0 by0 bx1 by1 = case n of
    (s, b, v, a, k, l, e) -> case overlap (tickOf n / 2 - 192) (tickOf n / 2 - 192 + l / 2) bx0 bx1 of
        True -> overlap ((64 - k) * 8 - 4) ((64 - k) * 8 + 4) by0 by1
        False -> False

overlap : Int -> Int -> Int -> Int -> Bool
overlap a0 a1 b0 b1 = case a0 <= b1 of
    True -> b0 <= a1
    False -> False

#: The band, an outline — the notes under it stay seen.
band : Int -> Int -> Int -> Int -> Sub
band x0 y0 x y = Shift ((x0 + x) / 2) ((y0 + y) / 2) (frame (max 1 (abs (x - x0))) (max 1 (abs (y - y0))))

frame : Int -> Int -> Sub
frame w h = Over (Over (Shift 0 (0 - h / 2) (Rect w 1 bandInk)) (Shift 0 (h / 2) (Rect w 1 bandInk)))
    (Over (Shift (0 - w / 2) 0 (Rect 1 h bandInk)) (Shift (w / 2) 0 (Rect 1 h bandInk)))

abs : Int -> Int
abs v = case v < 0 of
    True -> 0 - v
    False -> v

restInk : Colour
restInk = RGB 235 178 110

heldInk : Colour
heldInk = RGB 255 220 160

laneInk : Colour
laneInk = RGB 26 29 38

pickedInk : Colour
pickedInk = RGB 120 200 255

bandInk : Colour
bandInk = RGB 120 200 255

restOr : Bool -> Colour
restOr b = case b of
    True -> pickedInk
    False -> restInk

#: A note drawn where its row says, nothing in it pressable.
noteBar : NoteRow -> Colour -> Sub
noteBar n ink = case n of
    (s, b, v, a, k, l, e) -> Rect (l / 2) 7 ink

#: Where a note's end can be taken: 8 px past it, and its last 8 px too
#: when it is wider than 16 — the roll's end since 2026-09-24.  Drawn
#: over the bar and drawn as nothing, so where the two overlap the press
#: is the end's (F249).  `endAt` places what it is given there.
endOf : NoteRow -> Sub
endOf n = case n of
    (s, b, v, a, k, l, e) -> Gap (8 + inner l) 7

endAt : NoteRow -> Sub -> Sub
endAt n pic = case n of
    (s, b, v, a, k, l, e) -> Shift (l / 4 + 4 - inner l / 2) 0 pic

inner : Int -> Int
inner l = case l / 2 > 16 of
    True -> 8
    False -> 0

onRoll : NoteRow -> Sub -> Sub
onRoll n pic = case n of
    (s, b, v, a, k, l, e) -> Shift (tickOf n / 2 + l / 4 - 192) ((64 - k) * 8) pic

reactor Note (n : NoteRow) (to : Lens Model NoteRow) (mk : Lens Model Bool)
  mode Resting
    on grab x y -> Carrying x y x y
    on grab end x y -> Sizing x x
    picture = onRoll n (Over (hold (noteBar n (restOr (get mk)))) (endAt n (hold end (endOf n))))
  mode Carrying (x0 : Int) (y0 : Int) (x : Int) (y : Int)
    on drag x1 y1 -> Carrying x0 y0 x1 y1
    on release -> Resting
    on release -> to = put to (carried n (x - x0) (y - y0))
    picture = onRoll (carried n (x - x0) (y - y0)) (hold (noteBar n heldInk))
  mode Sizing (x0 : Int) (x : Int)
    on drag x1 y1 -> Sizing x0 x1
    on release -> Resting
    on release -> to = put to (sized n (x - x0))
    picture = onRoll (sized n (x - x0)) (hold end (noteBar (sized n (x - x0)) heldInk))

reactor Roll (all : Lens Model Tune) (sel : Lens Model (List Pick))
  notes = new Note n (moving n) (marked n) for n in elems (get all) by noteKey n
  mode Idle
    on grab x y -> Sweeping x y x y
    picture = Over (hold lane) notes.picture
  mode Sweeping (x0 : Int) (y0 : Int) (x : Int) (y : Int)
    on drag x1 y1 -> Sweeping x0 y0 x1 y1
    on release -> Idle
    on release -> sel = put sel (swept (get all) x0 y0 x y)
    picture = Over (hold lane) (Over notes.picture (band x0 y0 x y))

lane : Sub
lane = Rect 400 200 laneInk

substrate : Sig Sub
substrate = Roll.picture whole chosen both

#: Silence — the window plays every file it opens.
sound : Sig Float
sound = 0.0
