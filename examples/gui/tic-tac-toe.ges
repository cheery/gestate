# Tic-tac-toe — a board you play with the mouse.
#
#   python -m gestate.workbench examples/gui/tic-tac-toe.ges
#
# Press a cell to put your mark in it; X goes first.  Hold **Ctrl** and
# press to ask the window what is under the pointer.
#
# **Written to find out how much a small game costs here** — Henri,
# 2026-09-08, `card:gui-is-difficult.md`.  It is the four hard things in
# the smallest shape that has all of them: the picture is a function of
# the board, a press has to name a cell, a gesture is spread across two
# instants, and the drawing and the hit-testing must agree about where
# the thirds are.
#
# ── Where the input comes from, which is the part worth reading ─────────
#
# **Each cell says which cell it is, and a press writes that.**
# `onPress c v` attaches the number `v` to an element: press it and `v`
# goes to the channel `c`, once, and a drag over it writes nothing.  So
# a press *names the cell* and the game is a fold over cell numbers.
#
# **One channel, nine cells**, which is what makes this writable at all.
# A `Chan` is a declaration — its identity is where it is written — so
# nine cells could never be nine channels built from a list; nine
# meanings on one channel is what a list can build.
#
# **What this file used to do, and it is the measurement the word was
# added for** (`card:gui-is-difficult.md`, 2026-09-09).  There was one
# pad over the whole board and the program worked the cell out from
# where the press landed: `third f = clamp 0 2 (floor (f * 3.0))`, two
# axes arriving as two separate instants, an arrival counter to tell
# them apart, and `play` made idempotent to survive a drag's motions.
# All of it was the program re-deriving geometry the layout already
# knew — and it agreed with the layout by coincidence rather than by
# construction, which is hard thing 4 living inside the program.

# ── The model ────────────────────────────────────────────────────────────

#: What is in a cell.  `deriving Eq` is what gives `==` here, and it is
#: the difference between this line and twelve of nested `case`.
Mark := Empty | X | O deriving Eq

#: The board is nine cells, row-major: 0 1 2 across the top.
start : List Mark
start = Empty :: Empty :: Empty :: Empty :: Empty :: Empty :: Empty :: Empty :: Empty :: Nil

#: What is in cell `k` — `Empty` for an index off the board, so no caller
#: has to bound-check before asking.
markAt : List Mark -> Int -> Mark
markAt b k = case b of
    Nil -> Empty
    m :: rest -> case k == 0 of
        True -> m
        False -> markAt rest (k - 1)

#: The board with cell `k` set to `m`.
putAt : List Mark -> Int -> Mark -> List Mark
putAt b k m = case b of
    Nil -> Nil
    c :: rest -> case k == 0 of
        True -> m :: rest
        False -> c :: putAt rest (k - 1) m

#: How many cells hold `m`.
tally : List Mark -> Mark -> Int
tally b m = length (filter (c => c == m) b)

#: **Whose turn it is, read off the board and never carried.**  X goes
#: first, so it is X's turn whenever the two counts are level.  A turn
#: that is derived cannot drift from the board it belongs to, and a
#: press that changes nothing cannot advance it.
turn : List Mark -> Mark
turn b = case tally b X == tally b O of
    True -> X
    False -> O

#: The eight ways to win — three rows, three columns, two diagonals.
ways : List (Int, Int, Int)
ways = (0, 1, 2) :: (3, 4, 5) :: (6, 7, 8)
    :: (0, 3, 6) :: (1, 4, 7) :: (2, 5, 8)
    :: (0, 4, 8) :: (2, 4, 6) :: Nil

#: The mark that owns a line of three, or `Empty`.
owner : List Mark -> (Int, Int, Int) -> Mark
owner b (p, q, r) = case all (k => markAt b k == markAt b p) (q :: r :: Nil) of
    True -> markAt b p
    False -> Empty

#: Who has won, or `Empty` — the first way that is owned by somebody.
winner : List Mark -> Mark
winner b = case filter (m => m /= Empty) (map (w => owner b w) ways) of
    m :: rest -> m
    Nil -> Empty

#: **The move.**  A cell that is taken, an index off the board, or a
#: game already won all leave the board as it was — the game's own
#: rules, and no longer standing in for a release the canvas could not
#: see.
play : List Mark -> Int -> List Mark
play b k = case all (m => m == Empty) (winner b :: markAt b k :: Nil) of
    True -> putAt b k (turn b)
    False -> b

# ── The hand ─────────────────────────────────────────────────────────────

#: The channel every cell writes, and the only one this program has.
pressing : Chan Float
pressing = chan

#: **The game is one scan over cell numbers.**  It starts on a number
#: that is no cell, so the first instant plays nothing — `play` already
#: leaves the board alone for an index off the board, which is the
#: game's rule and not a guard written for this.
board : Sig (List Mark)
board = scan (b k => play b (floor k)) start
             ((0.0 - 1.0) ::: mkSig (wait pressing))

# ── The picture ──────────────────────────────────────────────────────────

cellSide : Int
cellSide = 60

tileInk : Colour
tileInk = RGB 38 42 52

xInk : Colour
xInk = RGB 122 200 235

oInk : Colour
oInk = RGB 235 178 110

footInk : Colour
footInk = RGB 120 124 134

#: One cell: a tile, the mark on it, and **which cell it is**.  The
#: meaning is built from the same `k` that chose what to draw, so what
#: a press means and what it looks like come from one expression.
cellPic : Int -> Mark -> Sub
cellPic k m = Meaning pressing (toFloat k)
    (Sized cellSide cellSide
        (Over (Rect (cellSide - 4) (cellSide - 4) tileInk) (markPic m)))

markPic : Mark -> Sub
markPic m = case m of
    Empty -> Gap 0 0
    X -> Label 26 26 "X" xInk
    O -> Label 26 26 "O" oInk

rowPic : List Mark -> Int -> Sub
rowPic b r = Row (tile b (r * 3))
                 (Row (tile b (r * 3 + 1)) (tile b (r * 3 + 2)))

tile : List Mark -> Int -> Sub
tile b k = cellPic k (markAt b k)

boardPic : List Mark -> Sub
boardPic b = Column (rowPic b 0) (Column (rowPic b 1) (rowPic b 2))

#: What the foot says — who is to move, or who won.
saying : List Mark -> Sub
saying b = case winner b of
    X -> Label 90 14 "X WINS" xInk
    O -> Label 90 14 "O WINS" oInk
    Empty -> case tally b Empty == 0 of
        True -> Label 90 14 "A DRAW" footInk
        False -> turnPic (turn b)

turnPic : Mark -> Sub
turnPic m = case m of
    X -> Label 90 14 "X TO PLAY" xInk
    _ -> Label 90 14 "O TO PLAY" oInk

#: **Nothing is attached here.**  What listens is each cell, inside the
#: picture, which is idea 2 kept: what is visible is what is pressable,
#: by construction.
substrate : Sig Sub
substrate = column (map boardPic board)
                   (sized (!190) (!24) (map saying board))

sound : Sig Float
sound = 0.0
