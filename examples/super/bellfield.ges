# BELLFIELD - FM bells scattered across a field, forever.
#
#   python -m gestate.audiolive examples/super/bellfield.ges
#   python -m gestate.audio examples/super/bellfield.ges -o bellfield.wav --seconds 45
#
# Steal: the fm bell patch with per-operator decays, and stereo made of
# two ears that strike at different rates - they can never line up, so
# the field never centres and never repeats.

#: An inharmonic pair (2 -> 1) plus a 3.51x sparkle pair (4 -> 3): a bell
#: in data.  Steal it whole; the 3.51 is what makes it metal.
bell : Patch
bell = Patch (Quad 1.0 2.0 3.51 5.19)
             (modulates 2 1 0.7 (modulates 4 3 0.4 noWiring))
             (Quad 1.0 0.0 0.25 0.0)

#: Modulators die faster than carriers: strike-bright, ring-pure.
ringOf : Float -> Quad
ringOf u = Quad (exp (negate 1.2 * u)) (exp (negate 5.0 * u))
                (exp (negate 2.0 * u)) (exp (negate 9.0 * u))

#: One ear: strikes retriggering at its own rate, pitch stepping through
#: a triad every few seconds.
ring : Float -> Sig Float
ring rate = fm bell
    (map (t => 220.0 * toFloat (1 + prim_mod_int (floor (t * 0.13)) 3)) elapsed)
    (map (u => ringOf (wrap (u * rate))) elapsed)
  * map (u => exp (negate 1.5 * wrap (u * rate))) elapsed

ear : Float -> Sig Float
ear rate = brickwall 0.9 (0.3 * ring rate + 0.5 * reverb 6.0 0.25 (0.3 * ring rate))

sound : Sig Stereo
sound = pair (ear 0.21) (ear 0.17)
