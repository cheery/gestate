# CHOIRLOFT - voices in a stone room, and nobody is singing words.
#
#   python -m gestate.audiolive examples/super/choirloft.ges
#   python -m gestate.audio examples/super/choirloft.ges -o choirloft.wav --seconds 40
#
# Steal: the singer - a detuned buzz through three formant bands IS a
# vowel - and the chord written as Ramp envelopes, so the voices *slide*
# between chords the way breath does, no note boundaries anywhere.

#: Each singer's pitch line, in Hz against seconds, gliding on the turn
#: of each chord: Am - F - C - G, eight seconds a chord, looping by clamp.
sopranoLine : List Envelope
sopranoLine = [ Step 0.0 440.0, Ramp 9.0 440.0, Ramp 10.0 523.25
              , Ramp 17.0 523.25, Ramp 18.0 493.88, Ramp 25.0 493.88
              , Ramp 26.0 440.0 ]

altoLine : List Envelope
altoLine = [ Step 0.0 261.63, Ramp 9.0 261.63, Ramp 10.0 349.23
           , Ramp 17.0 349.23, Ramp 18.0 329.63, Ramp 25.0 329.63
           , Ramp 26.0 261.63 ]

bassLine : List Envelope
bassLine = [ Step 0.0 110.0, Ramp 9.0 110.0, Ramp 10.0 87.31
           , Ramp 17.0 87.31, Ramp 18.0 98.0, Ramp 25.0 98.0
           , Ramp 26.0 110.0 ]

#: A singer: the buzz is two saws barely apart, the throat is three
#: formant bands (rough "ah"), the breath is a whisper of pink noise,
#: and the vibrato arrives on everything at once because it moves the
#: *pitch*.  Signal-level `let` keeps the wiring on one page.
singer : Sig Float -> Float -> Sig Float
singer hz depth = let bend = hz * (1.0 + 0.004 * sine 5.2)
                      buzz = saw bend + saw (bend * 1.004)
                              + 0.02 * pink (white 4)
                  in 1.3 * bandpassSvf 650.0 0.85 buzz
                   + 0.9 * bandpassSvf (!(1080.0 + 300.0 * depth)) 0.88 buzz
                   + 0.3 * bandpassSvf 2650.0 0.9 buzz

soprano : Sig Float
soprano = singer (map (t => on sopranoLine t) elapsed) 1.0

alto : Sig Float
alto = singer (map (t => on altoLine t) elapsed) 0.4

bass : Sig Float
bass = singer (map (t => on bassLine t) elapsed) 0.0

#: The loft: far more room than voice, which is what a choir in a church
#: is.  The swell is the whole piece breathing at once.
blend : Sig Float
blend = (0.30 * soprano + 0.4 * alto + 0.5 * bass)
      * (0.55 + 0.45 * unipolar (sine 0.05))

sound : Sig Float
sound = brickwall 0.9 (0.35 * blend + 0.65 * reverb 4.5 0.3 blend)
