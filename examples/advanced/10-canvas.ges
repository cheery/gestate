# Lesson 10: a face for the instrument - a ribbon, a fader, a meter.
#
#   python -m gestate.audiopygame examples/advanced/10-canvas.ges
#
# One file, two halves.  `sound` compiles and runs per sample; `substrate`
# is interpreted per frame; they meet on *channels* - a picture with a
# channel attached is a control, and the signal it feeds is the same
# signal the filter reads.  Nothing here is a widget.
#
# The ribbon is the instrument: touch it and the pitch glides to your
# finger - `slew` is the glide, and how fast is the whole feel of it.

# ── The controls: a channel, and what it holds before a touch ────────────

pitchTouch : Chan Float
pitchTouch = chan

#: 0..1 across the ribbon, clamped by the host to the element's extent.
pos : Sig Float
pos = 0.25 ::: mkSig (wait pitchTouch)

cutTouch : Chan Float
cutTouch = chan

#: The raw touch: 0 at the TOP of the element, 1 at the bottom - that is
#: what `onTouchY` reports.  A fader wants the opposite (up = more), so
#: `liftOf` inverts it once, and both readers - the filter and the
#: picture - go through it.  Invert in one place or you will meet the
#: flip again as a bug.
touchY : Sig Float
touchY = 0.5 ::: mkSig (wait cutTouch)

liftOf : Float -> Float
liftOf x = 1.0 - clamp 0.0 1.0 x

# ── What you hear ────────────────────────────────────────────────────────

#: Two octaves of ribbon.  `pow` makes equal distances equal intervals -
#: a linear ribbon crams the top octave into its last sixth.  The clamp
#: is law, not caution: a control is the one number the synth does not
#: compute, and the offline renderer deliberately sweeps every control
#: with the sample index so an unguarded one fails loudly at render time.
hzOfX : Float -> Float
hzOfX x = 82.41 * pow 2.0 (2.0 * clamp 0.0 1.0 x)

#: The glide.  try: 0.02 snaps like keys; 0.0005 is a theremin's slur.
glide : Sig Float
glide = slew 0.003 (!hzOfX pos)

cutHz : Float -> Float
cutHz v = 200.0 + 3800.0 * liftOf v * liftOf v

sound : Sig Float
sound = 0.3 * lowpassSvf (!cutHz touchY) 0.5 (saw glide + 0.5 * saw (glide * 0.5))

# ── What the instrument tells you ────────────────────────────────────────

peak : Chan Float
peak = chan

loud : Sig Float
loud = 0.0 ::: mkSig (wait peak)

# ── What you see ─────────────────────────────────────────────────────────

slate : Sig Colour
slate = colour 40 44 56

#: The ribbon: a wide track, and a finger-line where the touch is - the
#: same `pos` the pitch reads, so the picture cannot disagree with the
#: sound.
finger : Float -> Sub
finger x = Shift (floor (300.0 * (clamp 0.0 1.0 x - 0.5))) 0
                 (Rect 4 56 (RGB 235 170 70))

ribbon : Sig Sub
ribbon = onTouchX pitchTouch (over (rect 300 60 slate) (!finger pos))

#: The handle, high when the lift is high.  The canvas counts y
#: *downward*, so "up" is the negative arm of the mix.
handle : Float -> Sub
handle v = Shift 0 (floor (mix 90.0 (0.0 - 90.0) (liftOf v)))
                 (Rect 44 8 (RGB 220 220 200))

fader : Sig Sub
fader = onTouchY cutTouch (over (rect 36 180 slate) (!handle touchY))

#: The meter: `sized` reserves fixed room, so the row never breathes.
meter : Float -> Sub
meter v = Sized 24 180 (Rect 24 (floor (170.0 * v)) (RGB 90 200 110))

#: try: `column` the ribbon over a second one tuned an octave down - a
#: two-string instrument; `pad` and `gap` are the whitespace.
substrate : Sig Sub
substrate =
    (pad 10 ribbon `column` (fader `row` gap 24 0 `row` !meter loud))
