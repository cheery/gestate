# ── The ground, bar by bar ───────────────────────────────────────────────
#
# Roots and fifths, one to a bar, spelled out for the same reason the
# melody is.  A: D, D, G, D, D, D, A, A.  B: G half-diminished has no
# fifth, so the ♭5 is written and the emptiness is the point.  A′: D
# minor, with the ♭II under bar 20 and the dominant under bar 24.

g1 : [: Tone :]
g1 = '(Tone 0.80 38 0) ++ '(Tone 0.55 45 0) ++ '(Tone 0.65 38 0) ++ '(Tone 0.55 45 0)

g2 : [: Tone :]
g2 = '(Tone 0.75 38 0) ++ '(Tone 0.55 45 0) ++ '(Tone 0.65 38 0) ++ '(Tone 0.55 45 0)

g3 : [: Tone :]
g3 = '(Tone 0.80 43 0) ++ '(Tone 0.55 50 0) ++ '(Tone 0.65 43 0) ++ '(Tone 0.55 50 0)

g4 : [: Tone :]
