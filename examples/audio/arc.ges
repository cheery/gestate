g8 : [: Tone :]
g8 = '(Tone 0.80 45 0) ++ '(Tone 0.55 52 0) ++ '(Tone 0.65 45 0) ++ '(Tone 0.55 52 0)

#: B — **pedalled on G for all eight bars**, so every chord above it
#: becomes a slash chord that contradicts its own root: Ab/G, Cm/G,
#: A/G.  Measured, the places the ear can rest — a perfect fifth above
#: the sounding bass — go from **4 of 8 to 0 of 8**.  Locrian has no
#: perfect fifth above its tonic and so cannot establish itself the
#: ordinary way; it has to be insisted on, and this is the insisting.
h1 : [: Tone :]
h1 = '(Tone 0.80 43 0) ++ '(Tone 0.55 49 0) ++ '(Tone 0.65 43 0) ++ '(Tone 0.55 49 0)

h2 : [: Tone :]
h2 = '(Tone 0.75 43 0) ++ '(Tone 0.55 49 0) ++ '(Tone 0.65 43 0) ++ '(Tone 0.55 49 0)

h3 : [: Tone :]
h3 = '(Tone 0.80 44 0) ++ '(Tone 0.55 51 0) ++ '(Tone 0.65 44 0) ++ '(Tone 0.55 51 0)

h4 : [: Tone :]
h4 = '(Tone 0.75 43 0) ++ '(Tone 0.55 49 0) ++ '(Tone 0.65 43 0) ++ '(Tone 0.55 49 0)

h5 : [: Tone :]
h5 = '(Tone 0.80 46 0) ++ '(Tone 0.55 53 0) ++ '(Tone 0.65 46 0) ++ '(Tone 0.55 53 0)

h6 : [: Tone :]
h6 = '(Tone 0.75 44 0) ++ '(Tone 0.55 51 0) ++ '(Tone 0.65 44 0) ++ '(Tone 0.55 51 0)

h7 : [: Tone :]
h7 = '(Tone 0.80 43 0) ++ '(Tone 0.55 49 0) ++ '(Tone 0.65 43 0) ++ '(Tone 0.55 49 0)

#: Bar 16 — the deceptive cadence.  A7 underneath the line's cry for D,
#: and then B, not D: 5 going to 6 instead of to 1.
h8 : [: Tone :]
h8 = '(Tone 0.85 45 0) ++ '(Tone 0.60 52 0) ++ '(Tone 0.85 47 0) ++ '(Tone 0.60 54 0)

#: A′ — D minor, with the flat second under bar 20.
i1 : [: Tone :]
i1 = '(Tone 0.80 38 0) ++ '(Tone 0.55 45 0) ++ '(Tone 0.65 38 0) ++ '(Tone 0.55 45 0)

i2 : [: Tone :]
i2 = '(Tone 0.75 38 0) ++ '(Tone 0.55 45 0) ++ '(Tone 0.65 38 0) ++ '(Tone 0.55 45 0)

i3 : [: Tone :]
i3 = '(Tone 0.80 43 0) ++ '(Tone 0.55 50 0) ++ '(Tone 0.65 43 0) ++ '(Tone 0.55 50 0)

i4 : [: Tone :]
i4 = '(Tone 0.80 39 0) ++ '(Tone 0.55 46 0) ++ '(Tone 0.65 39 0) ++ '(Tone 0.55 46 0)

i5 : [: Tone :]
i5 = '(Tone 0.80 38 0) ++ '(Tone 0.55 45 0) ++ '(Tone 0.65 38 0) ++ '(Tone 0.55 45 0)

i6 : [: Tone :]
i6 = '(Tone 0.75 38 0) ++ '(Tone 0.55 45 0) ++ '(Tone 0.65 38 0) ++ '(Tone 0.55 45 0)

i7 : [: Tone :]
i7 = '(Tone 0.80 39 0) ++ '(Tone 0.55 46 0) ++ '(Tone 0.65 39 0) ++ '(Tone 0.55 46 0)

#: Bar 24 — the perfect cadence: A to D, and it stops.
i8 : [: Tone :]
i8 = '(Tone 0.85 45 0) ++ '(Tone 0.60 52 0) ++ '(Tone 0.90 38 0) ++ '(Tone 0.60 38 0)

# ── What it plays ────────────────────────────────────────────────────────
#
# Twenty-four bars, laid out one after another, because that is what
# there is to say them with.

melody : [: Tone :]
melody = a1 ++ a2 ++ a3 ++ a4 ++ a5 ++ a6 ++ a7 ++ a8
      ++ b1 ++ b2 ++ b3 ++ b4 ++ b5 ++ b6 ++ b7 ++ b8
      ++ c1 ++ c2 ++ c3 ++ c4 ++ c5 ++ c6 ++ c7 ++ c8

bass : [: Tone :]
bass = g1 ++ g2 ++ g3 ++ g4 ++ g5 ++ g6 ++ g7 ++ g8
    ++ h1 ++ h2 ++ h3 ++ h4 ++ h5 ++ h6 ++ h7 ++ h8
    ++ i1 ++ i2 ++ i3 ++ i4 ++ i5 ++ i6 ++ i7 ++ i8

upper : [: Tone :]
upper = upper1 ++ upper2 ++ upper3 ++ upper4 ++ upper5 ++ upper6 ++ upper7 ++ upper8
     ++ upper9 ++ upper10 ++ upper11 ++ upper12 ++ upper13 ++ upper14 ++ upper15 ++ upper16
     ++ upper17 ++ upper18 ++ upper19 ++ upper20 ++ upper21 ++ upper22 ++ upper23 ++ upper24

middle : [: Tone :]
middle = middle1 ++ middle2 ++ middle3 ++ middle4 ++ middle5 ++ middle6 ++ middle7 ++ middle8
      ++ middle9 ++ middle10 ++ middle11 ++ middle12 ++ middle13 ++ middle14 ++ middle15 ++ middle16
      ++ middle17 ++ middle18 ++ middle19 ++ middle20 ++ middle21 ++ middle22 ++ middle23 ++ middle24

lower : [: Tone :]
lower = lower1 ++ lower2 ++ lower3 ++ lower4 ++ lower5 ++ lower6 ++ lower7 ++ lower8
     ++ lower9 ++ lower10 ++ lower11 ++ lower12 ++ lower13 ++ lower14 ++ lower15 ++ lower16
     ++ lower17 ++ lower18 ++ lower19 ++ lower20 ++ lower21 ++ lower22 ++ lower23 ++ lower24

roots : [: Tone :]
roots = root1 ++ root2 ++ root3 ++ root4 ++ root5 ++ root6 ++ root7 ++ root8
     ++ root9 ++ root10 ++ root11 ++ root12 ++ root13 ++ root14 ++ root15 ++ root16
     ++ root17 ++ root18 ++ root19 ++ root20 ++ root21 ++ root22 ++ root23 ++ root24

#: **Five lines, aligned by nothing but their lengths.**  Twenty-four
#: bars in each, and if one of them had twenty-three the piece would
#: still compile and everything after the short one would be a bar out.
#:
#: **And for a fortnight it played the wrong one** — `fixme.md` F198.
#: `bass` above carries the I-IV-V and the deceptive cadence this file's
#: own comments describe; `roots` is an earlier line that does not, and
#: `score` named `roots`.  So every comment here was true of the notes
#: and false of the sound, and three separate readings — including
#: `doc/notes/notes-on-writing-a-piece.md` on bar 16 — concluded the
#: prose was lying when it was the score that was.
#:
#: Henri chose, 2026-09-05, having heard both: *"arc-bassonly is
#: better.  I like the bass moving there."*  `roots` is kept rather than
#: deleted, because it is what was written on the day and this file is
#: an exhibit — but it is **not played**, and that sentence is the one
#: nothing said before.
score : [: Void :]
score = (melody >>= voices.song)
     || (upper >>= voices.chord) || (middle >>= voices.chord)
     || (lower >>= voices.chord) || (bass >>= voices.ground)

bpm : Int
bpm = 92
