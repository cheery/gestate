# arc.ges — bright, brutal, dark: D lydian → G locrian → D phrygian.
#
#   python -m gestate.audioperform examples/audio/arc.ges -o take.wav
#
# **Written to find out what a notation format has to carry** —
# `doc/notes/notes-on-writing-a-piece.md` is the log and the point.  So
# every note here is **spelled out**, with no helper and no repetition
# operator anywhere: the tedium is the measurement.  A file that reached
# for `quad (…) |/ 8` would be shorter and would have hidden the thing
# we are trying to see.
#
# Henri's brief, 2026-09-04: standard blues/jazz harmony, 1-4-5,
# ABA-form, lydian in A, locrian in B, phrygian on the return; deceptive
# cadence in the middle, perfect at the end; D, to G, and back.

# ── What is written ──────────────────────────────────────────────────────

Tone := Tone Float Int Int

instance Notable Tone where
    noteKey t = case t of
        Tone v k m -> k
    noteVel t = case t of
        Tone v k m -> floor (v * 127.0)
    manner t = case t of
        Tone v k m -> m

hzOf : Tone -> Float
hzOf t = case t of
    Tone v k m -> keyHz k

velOf : Tone -> Float
velOf t = case t of
    Tone v k m -> v

bowOf : Tone -> Float
bowOf t = case asks (manner t) Staccato of
    True  -> 1.0
    False -> 0.0

pushOf : Tone -> Float
pushOf t = case asks (manner t) Accent of
    True  -> 1.0
    False -> 0.0

glideOf : Tone -> Float
glideOf t = case asks (manner t) Portamento of
    True  -> 0.0007
    False -> 1.0

# ── What plays it ────────────────────────────────────────────────────────

#: The lead: a saw through a filter that opens on an accent, shortens on
#: a staccato, and slides into a note that asked to be arrived at.
#: `spec/annotations.md` is the design; this is the third voice written
#: to it and the first in a piece rather than a demo.
lead : Sig Gate -> Sig Tone -> Sig Float
lead g s =
    lowpassSvf (1100.0 + (!pushOf s) * 2400.0 * perc 20.0 g) 0.30
               (saw (slew (!glideOf s) (!hzOf s)))
        * (!velOf s) * 0.26
        * (perc 4.0 g * (1.0 - (!bowOf s)) + perc 18.0 g * (!bowOf s))

voices song 4 lead : Sig Float

#: The ground: a triangle two octaves down, round and slow, so the modes
#: are heard against a root rather than in the air.
under : Sig Gate -> Sig Tone -> Sig Float
under g s = lowpassSvf 320.0 0.16 (triangle (!hzOf s) * 0.6)
    * (!velOf s) * 0.34 * adsr (Adsr 0.02 0.20 0.75 0.30) g

voices ground 2 under : Sig Float

#: The harmony's own bank — three voices, because they sound at once
#: and each holds a whole bar.
#:
#: **It sustains, and that is the whole of pass three.**  Henri, on pass
#: two: *"the chords could be more present, they sink into the
#: background now"* — and they did, because this voice used `perc`,
#: which `synth.ges` says in as many words is *"for a struck or plucked
#: voice, which does not sustain"*.  A whole-bar chord under a
#: percussive envelope states its mode for an instant and then leaves
#: two seconds of nothing, so the piece had harmony on paper and almost
#: none in the air.  `adsr` with a real sustain is what a held chord
#: needs, and a mode is a *chord you are still hearing*.
chordVoice : Sig Gate -> Sig Tone -> Sig Float
chordVoice g s = lowpassSvf 1500.0 0.20
    (saw (!hzOf s) * 0.35 + triangle (!hzOf s) * 0.65)
    * (!velOf s) * 0.42 * adsr (Adsr 0.04 0.35 0.80 0.45) g

voices chord 3 chordVoice : Sig Float

sound : Sig Float
sound = reverb 0.55 0.20 (song + chord + ground)

# ── A — D lydian, bright ─────────────────────────────────────────────────
#
# D E F# G# A B C#.  The G# is the mode: over a D7 it lands as the #11,
# which is lydian dominant and idiomatic rather than clever.  Blues bones
# underneath — I, IV, V as D7, G7, A7.

#: Bar 1 — I.  D over D7, reaching up to the sharp fourth and settling.
a1 : [: Tone :]
a1 = '(Tone 0.85 62 0) ++ '(Tone 0.70 66 0) ++ '(Tone 0.80 68 2) ++ '(Tone 0.65 69 0)

#: Bar 2 — I still, the G# said again a step higher so the ear catches it.
a2 : [: Tone :]
a2 = '(Tone 0.75 71 0) ++ '(Tone 0.70 68 0) ++ '(Tone 0.85 66 1) ++ '(Tone 0.60 64 1)

#: Bar 3 — IV.  G7, and the melody keeps the C# above it, which is the
#: lydian colour arriving on a chord that does not own it.
a3 : [: Tone :]
a3 = '(Tone 0.80 67 0) ++ '(Tone 0.70 71 0) ++ '(Tone 0.85 73 2) ++ '(Tone 0.65 71 0)

#: Bar 4 — back to I, falling.
a4 : [: Tone :]
a4 = '(Tone 0.75 69 0) ++ '(Tone 0.70 68 0) ++ '(Tone 0.80 66 0) ++ '(Tone 0.70 62 0)

#: Bars 5-6 — the same thought twice more, the rule of three: said once,
#: again a little differently, and the third time it breaks upward.
a5 : [: Tone :]
a5 = '(Tone 0.85 62 0) ++ '(Tone 0.70 66 0) ++ '(Tone 0.80 68 2) ++ '(Tone 0.65 71 0)

a6 : [: Tone :]
a6 = '(Tone 0.75 73 0) ++ '(Tone 0.70 71 0) ++ '(Tone 0.85 68 1) ++ '(Tone 0.60 66 1)

#: Bar 7 — V.  A7, the fifth held, leaning.
a7 : [: Tone :]
a7 = '(Tone 0.85 69 0) ++ '(Tone 0.70 73 0) ++ '(Tone 0.80 76 2) ++ '(Tone 0.70 73 0)

#: Bar 8 — the third saying, broken: it climbs past where it went before
#: and stops on the sharp fourth instead of the tonic.
a8 : [: Tone :]
a8 = '(Tone 0.80 74 0) ++ '(Tone 0.75 76 0) ++ '(Tone 0.85 80 2) ++ '(Tone 0.70 80 4)

# ── B — G locrian ────────────────────────────────────────────────────────
#
# G Ab Bb C Db Eb F.  **Rewritten from Henri's own attempt**
# (`examples/midi/maybe-locrian.mid`), which does four things this
# section did not, and every one of them is measurable:
#
# * **the tonic is hammered** — 39% of his notes against 9% of the
#   first draft's, and the line always returns to it;
# * **the colour is the ♭2, not the ♭5** — G against Ab, said again and
#   again, which is the maqam sound he found while reading; the tritone
#   appears once here where it was in nearly every bar before;
# * **it is a short cell repeated**, not a scale walked;
# * **it moves by step and rarely turns** — 70% of his moves are a tone
#   or less, the semitone is his commonest interval, and his widest
#   leap is a fifth.  The first rewrite of this section leapt a minor
#   seventh three times and changed direction on 44% of its notes: it
#   was *picking notes from the scale* rather than moving through it,
#   which is the difference between a line and a list;
# * and **it runs at eighths and sixteenths** — 56 of his 57 notes are
#   shorter than a quarter, where every one of the first draft's 91 was
#   a quarter or longer.  Which is `W1` arriving as a musical fault:
#   length is not a property of a note here, so the easy thing to write
#   is the rhythmically dead thing, and it was written four times;
# * and **the structural cues all point at G** — it is the *first* note
#   of the section, the *last*, the *lowest*, and the *longest held*.
#
# That last one is the sharpest and neither of us used it on purpose.
# His file's tonic is the most frequent note and its structure still
# argues for a different one, because first-last-lowest-longest beat
# frequency.  So they are spent on G here deliberately.
#
# `doc/notes/notes-on-writing-a-piece.md` has the counts.

#: Bar 9 — the arrival, and the ♭2 immediately, so the darkness is not
#: eased into.
b1 : [: Tone :]
b1 = ('(Tone 0.88 67 0) ++ '(Tone 0.72 68 0) ++ '(Tone 0.80 67 0) ++ '(Tone 0.84 67 0) ++ '(Tone 0.78 72 0) ++ '(Tone 0.72 70 0) ++ '(Tone 0.70 68 0) ++ '(Tone 0.86 67 0)) |/ 2

#: Bar 10 — the flat fifth, which is the mode's own wound.
b2 : [: Tone :]
b2 = ('(Tone 0.78 67 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 72 0) ++ '(Tone 0.78 70 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 67 0)) |/ 2

#: Bar 11 — down through the ♭6 and ♭7, no foothold anywhere.
b3 : [: Tone :]
b3 = ('(Tone 0.78 73 0) ++ '(Tone 0.78 72 0) ++ '(Tone 0.78 70 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 67 0)) |/ 2

#: Bar 12 — a slide down into the ♭2 again, sagging.
b4 : [: Tone :]
b4 = ('(Tone 0.78 72 0) ++ '(Tone 0.78 70 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 73 0) ++ '(Tone 0.78 72 0) ++ '(Tone 0.78 70 0) ++ '(Tone 0.78 68 0)) |/ 2

#: Bars 13-15 — the same shape wound tighter and higher, because the
#: section has nowhere stable to go and climbing is the only motion left.
b5 : [: Tone :]
b5 = ('(Tone 0.78 75 0) ++ '(Tone 0.78 73 0) ++ '(Tone 0.78 72 0) ++ '(Tone 0.78 70 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 67 0)) |/ 2

b6 : [: Tone :]
b6 = ('(Tone 0.78 67 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 70 0) ++ '(Tone 0.78 72 0) ++ '(Tone 0.78 73 0)) |/ 2

b7 : [: Tone :]
b7 = ('(Tone 0.78 75 0) ++ '(Tone 0.78 73 0) ++ '(Tone 0.78 72 0) ++ '(Tone 0.78 70 0) ++ '(Tone 0.78 68 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 67 0) ++ '(Tone 0.78 67 0)) |/ 2

#: Bar 16 — the hinge.  The line lands on A, the fifth of D, and asks
#: for home; what comes underneath is not home.
b8 : [: Tone :]
b8 = ('(Tone 0.90 67 0) |* 2) ++ '(Tone 0.80 68 0) ++ '(Tone 0.92 67 2)

# ── A′ — D phrygian, dark and settled ────────────────────────────────────
#
# D Eb F G A Bb C.  The Eb is the signature, and ♭II–i is the sound of
# the return: the same room as A, with the light off.

#: Bar 17 — home, but minor, and the ♭2 on the second beat says which
#: mode this is before anything else can.
c1 : [: Tone :]
c1 = '(Tone 0.85 62 0) ++ '(Tone 0.75 63 2) ++ '(Tone 0.70 65 0) ++ '(Tone 0.80 67 0)

#: Bar 18 — the A section's own shape, remembered in the dark: the same
#: contour as `a1`, a semitone flatter where the mode differs.
c2 : [: Tone :]
c2 = '(Tone 0.75 69 0) ++ '(Tone 0.70 67 0) ++ '(Tone 0.85 65 1) ++ '(Tone 0.60 63 1)

#: Bar 19 — iv, falling.
c3 : [: Tone :]
c3 = '(Tone 0.80 67 0) ++ '(Tone 0.70 70 0) ++ '(Tone 0.85 72 2) ++ '(Tone 0.65 70 0)

#: Bar 20 — down onto the ♭2 and lean there.
c4 : [: Tone :]
c4 = '(Tone 0.75 69 0) ++ '(Tone 0.70 67 0) ++ '(Tone 0.80 63 4) ++ '(Tone 0.70 62 0)

#: Bars 21-23 — the third saying, and this time it does not break
#: upward; it walks down to the cadence.
c5 : [: Tone :]
c5 = '(Tone 0.85 62 0) ++ '(Tone 0.75 63 0) ++ '(Tone 0.80 65 2) ++ '(Tone 0.65 67 0)

c6 : [: Tone :]
c6 = '(Tone 0.80 70 0) ++ '(Tone 0.75 69 0) ++ '(Tone 0.85 67 1) ++ '(Tone 0.70 65 1)

c7 : [: Tone :]
c7 = '(Tone 0.85 63 0) ++ '(Tone 0.70 65 0) ++ '(Tone 0.80 67 0) ++ '(Tone 0.75 69 2)

#: Bar 24 — the perfect cadence.  The leading tone is borrowed from the
#: harmonic minor because a perfect cadence needs one and phrygian has
#: none; that borrowing is the oldest lie in the repertoire.
c8 : [: Tone :]
c8 = '(Tone 0.85 73 0) ++ '(Tone 0.80 69 0) ++ '(Tone 0.90 62 2) ++ '(Tone 0.70 62 0)

# ── The harmony — three voices, each its own line ────────────────────────
#
# **Pass two.**  Henri, hearing pass one: *"bright all through… tonal
# center is missing, and harmony would do lots to the tone, but it's
# absent.  Harmony with open chords in it, voice leaded as individual
# voices."*  He was right and the file proved it: every interval in the
# first pass's ground was a **perfect fifth**, and a bare fifth is
# modeless, so lydian and phrygian sounded identical.
#
# The whole arc is now one semitone in one voice — bar 1 is A D **F♯**
# and bar 17 is A D **F** — which is what a third is for.
#
# The voicings are **minimal-motion, no crossings, every chord tone
# present, and open** (no interval under a minor third).  That last
# constraint had to be *stated*: a leader told only to move least drops
# the third, because dropping it moves least, and it produced A D A for
# a D minor before anybody looked.
#
# Written out one voice at a time, as he asked, so each line is a line.
# `doc/notes/notes-on-writing-a-piece.md` has what that cost.

