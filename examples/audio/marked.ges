# marked.ges — the same notes, played two ways — `spec/annotations.md`'s demo.
#
#   python -m gestate.audioperform examples/audio/marked.ges -o take.wav
#
# **One mark, and two voices that disagree about it.**  The line is
# written once and played four times; the only thing that ever changes is
# the manner field, and the only reason it sounds different is that one
# of these voices decided it should.
#
#   1. the bow, unmarked          notes run into each other
#   2. the bow, staccato          detached — it chose a quicker envelope
#   3. the pad, unmarked          long and soft
#   4. the pad, staccato          **exactly the same as 3**
#
# The fourth phrase is the point of the file.  `padVoice` never reads a
# manner, so the mark reaches it and does nothing, and that is not a bug
# — a pad has no bow.  A mark names an **intention**; what it means is
# the voice's, which is what a score has always asked of a player.
#
# `spec/annotations.md` is the design; the manner names, `asks` and
# `Notable`'s `manner` method are in `audio.ges`.  One class, because
# the box draws the mark and the voice plays it and neither should need
# a second constraint for one fact about a note.

# ── What is written ──────────────────────────────────────────────────────

#: Weight, degree, and the manners asked for.  **All three are `Int` or
#: `Float` and they have to be**: every payload field becomes a control
#: channel and a control value is one slot, so the manners travel as a
#: set of bits rather than as a list (`spec/annotations.md` §"What the
#: compiler refused").
Tone := Tone Float Int Int

#: A major pentatonic — nothing here turns on the notes, they are only
#: something to be played two ways.
stepOf : Int -> Int
stepOf d = case d of
    0 -> 0
    1 -> 2
    2 -> 4
    3 -> 7
    4 -> 9
    _ -> 12

hzOf : Tone -> Float
hzOf t = case t of
    Tone v d m -> keyHz (57 + stepOf d)

velOf : Tone -> Float
velOf t = case t of
    Tone v d m -> v

#: **The box reads this to draw the note and the voice reads it to play
#: one** — one class, because the mark is wanted by both.  `noteKey`
#: answers in MIDI numbers, which is what a roll's vertical axis is.
instance Notable Tone where
    noteKey t = case t of
        Tone v d m -> 57 + stepOf d
    noteVel t = case t of
        Tone v d m -> floor (v * 127.0)
    manner t = case t of
        Tone v d m -> m

# ── The voice that reads the mark ────────────────────────────────────────

#: **0.0 or 1.0, and not a rate.**  `perc` takes a `Float`, not a `Sig
#: Float`, so a voice cannot parameterise its envelope per note — it
#: blends two envelopes it computed anyway.  That is the shape a manner
#: is honoured in throughout, and it prices the feature honestly: one
#: control slot per voice, and a doubling of whatever the manner varies.
bowOf : Tone -> Float
bowOf t = case asks (manner t) Staccato of
    True  -> 1.0
    False -> 0.0

#: And the same, for the accent.
pushOf : Tone -> Float
pushOf t = case asks (manner t) Accent of
    True  -> 1.0
    False -> 0.0

#: **A one-pole coefficient, not hertz a sample.**  `slewStep` is
#: `y + k * (t - y)`, so **1.0 arrives at once** — which is what makes
#: this transparent to a note that asked for nothing — and a small
#: number takes its time.  Reading it as a rate overshoots and diverges
#: to NaN, which is how this file learned the difference.
glideOf : Tone -> Float
glideOf t = case asks (manner t) Portamento of
    True  -> 0.0006
    False -> 1.0

#: A bowed string, near enough: a saw through a filter, struck and left
#: to ring — or not, if the note asked to be detached.
#:
#: **The staccato is a shorter stroke, not a quieter note.**  Both
#: envelopes reach the same height and one of them lets go sooner, which
#: is why the marked phrase is not simply the unmarked one turned down.
#:
#: **And the accent is in the attack, not in the level.**  A faster bow
#: opens the string's brightness for the first instant and it settles
#: back — so the filter is lifted by an envelope of its own rather than
#: the note being made louder, which is what a velocity number would
#: have done and what the score deliberately did not say.  The two marks
#: are independent: a note may ask for both, and the arithmetic below
#: adds rather than chooses.
#: **And the portamento is the finger, not the note.**  The pitch is
#: slewed toward where the note is written, so a marked note *arrives*
#: rather than appearing — and what it arrives **from** is whatever this
#: voice last played, which is the allocator's business and not the
#: score's.  In a line taken one note at a time that is the note before,
#: which is what a violinist means.  Across a chord it is whichever note
#: this voice happened to hold, and the file says so rather than
#: pretending the mark means more than it can.
bowVoice : Sig Gate -> Sig Tone -> Sig Float
bowVoice g s =
    lowpassSvf (1400.0 + (!pushOf s) * 2600.0 * perc 22.0 g) 0.28
               (saw (slew (!glideOf s) (!hzOf s)))
        * (!velOf s) * 0.32
        * (perc 5.0 g * (1.0 - (!bowOf s)) + perc 20.0 g * (!bowOf s))

voices bow 4 bowVoice : Sig Float

# ── The voice that does not ──────────────────────────────────────────────

#: **This is a complete program and not a stub.**  It never mentions
#: `manner`, so every mark in the score reaches it and none of them does
#: anything.  Nothing warns, because there is nothing wrong: the score
#: asked for a bow stroke and this instrument has no bow.
padVoice : Sig Gate -> Sig Tone -> Sig Float
padVoice g s = triangle (!hzOf s) * (!velOf s) * 0.22 * perc 1.1 g

voices pad 3 padVoice : Sig Float

#: Both banks into one output.  They never sound at once — the score
#: hands the line to one and then to the other — so this is a sum of two
#: things only one of which is ever busy.
sound : Sig Float
sound = bow + pad

# ── What is played ───────────────────────────────────────────────────────

#: One line, written once.  `m` is the whole experiment.
line : Int -> [: Tone :]
line m = '(Tone 0.9 0 m) ++ '(Tone 0.9 1 m) ++ '(Tone 0.9 2 m) ++ '(Tone 0.9 3 m)
      ++ '(Tone 0.9 4 m) ++ '(Tone 0.9 3 m) ++ '(Tone 0.9 2 m) ++ '(Tone 0.9 1 m)

score : [: Void :]
score = ((line Plain ++ line Staccato) >>= voices.bow)
     ++ ((line Plain ++ line Staccato) >>= voices.pad)

bpm : Int
bpm = 104
