    edit "0:1:# After Chopin — the E minor prelude, Op. 28 No. 4, simplified." "2:2:#   python -m gestate.workbench examples/audio/chopin.ges" "5:2:# The piece is two ideas: a melody that sighs on one note, and chords\n# under it that sink by semitones — one voice of the chord slipping at a\n# time while the others hold.  That is why it fits this file: the whole\n# harmony is a ladder written note by note, `pachelbel.ges`'s argument\n# in minor.  What stands here is the opening period, not the prelude\n# entire: the descent, the turn through E7 toward A minor, and the close\n# back on B7 into E minor.\n#\n# **The visual is the instrument seen** (`spec/substrate.md`): a disc\n# that breathes with the output's own peak, and eight hammer lamps — one\n# per voice of the bank — that strike bright and cool as their notes\n# age.  Chords land as three lamps at once; the tune holds one lamp lit\n# across the bar.  `envelope.ges` is the probe's teaching example; this\n# is a probe put to a piece." "8:0:# ── The piece, seen ──────────────────────────────────────────────────────\n#\n# The bare `canvas` line below is the ask (`spec/workbench.md` §\"Content\n# boxes\"): the walked canvas stands as a live box right on that line —\n# `sink`'s manners, one line, one-line undo, and the file remembers.\n# The disc is the output's own peak breathing, and the eight lamps are\n# the bank's eight voices — struck bright, cooling as their notes age.\n# A chord is three lamps at once; the tune is one lamp held across the\n# bar.\n\ncanvas\n\ncanvas discOf 5.0\n\ndim : Sig Colour\ndim = colour 120 124 134\n\n#: The breath: a disc whose radius is the output's own peak.  `Sized`\n#: reserves the loudest breath's room, so the lamps below do not ride\n#: it — and the radius is clamped to that room, because the extent is\n#: declared and a circle that outgrows its own box is cut by whatever\n#: pane it lands in (it was, by the canvas box's top edge).\ndiscOf : Float -> Sub\ndiscOf v = Sized 170 96\n    (Circle (8 + floor (clamp 0.0 40.0 (v * 110.0))) (RGB 214 178 110))\n\n#: A hammer lamp.  Cold is a coal; struck is bright at its own hue and\n#: shrinks as the probe's age grows — about a third of a second a step,\n#: so a chord's afterglow fades over the bar it belongs to.  The age is\n#: one past the truth (`0` is *no voice*), the probe's own convention.\nemberOf : Int -> Float -> Sub\nemberOf i age = case age < 1.0 of\n    True -> Circle 2 (RGB 58 56 66)\n    False -> Circle (11 - floor (clamp 0.0 7.0\n                       ((age - 1.0) / (0.35 * sampleRate))))\n                    (hueOf i)\n\n#: Ivory into amber, one shade per voice, so two lamps lit by one chord\n#: are still two voices.\nhueOf : Int -> Colour\nhueOf i = RGB (236 - 6 * i) (206 - 10 * i) (152 - 8 * i)\n\nlampAt : Int -> Float -> Sub\nlampAt i age = Sized 30 30 (emberOf i age)\n\nlamps : Sig Sub\nlamps = !lampAt 0 age0 `row` !lampAt 1 age1\n `row` !lampAt 2 age2 `row` !lampAt 3 age3\n `row` !lampAt 4 age4 `row` !lampAt 5 age5\n `row` !lampAt 6 age6 `row` !lampAt 7 age7\n\ncaption : Sig Sub\ncaption = label 150 14 \"OP. 28 NO. 4\" dim\n\nsubstrate : Sig Sub\nsubstrate = gap 0 14 `column` !discOf loud `column` gap 0 12\n            `column` lamps `column` gap 0 10 `column` caption\n\n# ── What the instrument tells you ────────────────────────────────────────\n\npeak : Chan Float\npeak = chan\n\nloud : Sig Float\nloud = 0.0 ::: mkSig (wait peak)\n\n# One probe per voice — the age in samples, `0` when silent\n# (`envelope.ges` is the long explanation).\n\nprobe0 : Chan Float\nprobe0 = chan\nprobe1 : Chan Float\nprobe1 = chan\nprobe2 : Chan Float\nprobe2 = chan\nprobe3 : Chan Float\nprobe3 = chan\nprobe4 : Chan Float\nprobe4 = chan\nprobe5 : Chan Float\nprobe5 = chan\nprobe6 : Chan Float\nprobe6 = chan\nprobe7 : Chan Float\nprobe7 = chan\n\nage0 : Sig Float\nage0 = 0.0 ::: mkSig (wait probe0)\nage1 : Sig Float\nage1 = 0.0 ::: mkSig (wait probe1)\nage2 : Sig Float\nage2 = 0.0 ::: mkSig (wait probe2)\nage3 : Sig Float\nage3 = 0.0 ::: mkSig (wait probe3)\nage4 : Sig Float\nage4 = 0.0 ::: mkSig (wait probe4)\nage5 : Sig Float\nage5 = 0.0 ::: mkSig (wait probe5)\nage6 : Sig Float\nage6 = 0.0 ::: mkSig (wait probe6)\nage7 : Sig Float\nage7 = 0.0 ::: mkSig (wait probe7)\n\n# ── What a note carries ──────────────────────────────────────────────────\n\nHammer := Hammer Int Int                    # key number, velocity\n\n#: Eight, exactly the probes the editor can hand back: at the thickest a\n#: chord's three tails overlap the next stroke's three notes while the\n#: tune holds a note over both, and the eighth is the tune's own tail.\nvoices piano 8 hammerVoice : Sig Float\n\ninstance FromMIDI Hammer where\n    noteOn ch p v = Just (Hammer p v)\n\n# ── The instrument ───────────────────────────────────────────────────────\n\n#: Struck, not bowed: the attack is immediate, the body is decay, and\n#: what sustain there is stands low — a held key on a piano is a note\n#: getting quieter slowly.\nenv : Adsr\nenv = Adsr 0.004 1.4 0.25 0.4\n\nhzOf : Hammer -> Float\nhzOf h = case h of\n    Hammer k v -> keyHz k\n\nlevelOf : Hammer -> Float\nlevelOf h = case h of\n    Hammer k v -> toFloat v / 127.0\n\n#: A fundamental and two overtones, each quieter — enough of a spectrum\n#: to read as felt on string without pretending to be a piano.\ntimbre : Sig Float -> Sig Float\ntimbre hz = sine hz + 0.4 * sine (hz * 2.0) + 0.15 * sine (hz * 3.0)\n\nhammerVoice : Sig Gate -> Sig Hammer -> Sig Float\nhammerVoice g s = timbre (!hzOf s) * adsr env g * !levelOf s\n\n# ── The piece ────────────────────────────────────────────────────────────\n#\n# Largo, 4/4 here: four chord strokes to the bar where Chopin writes\n# eight quavers, and the melody in the long values it actually has.\n# Every chord below is three notes written side by side with `||`, and\n# the descent is legible in the numbers: one column of the stroke moves\n# down a semitone per bar while the others wait their turn.\n\nbpm : Int\nbpm = 46\n\n#: A chord tone, quiet — there are three at once and they are the floor\n#: the tune stands on, eight strokes a bar in the original and four here.\nquiet : Int -> [: Hammer :]\nquiet k = '(Hammer k 46)\n\n#: The tune, singing clear of the accompaniment.\nsing : Int -> [: Hammer :]\nsing k = '(Hammer k 84)\n\n#: Three notes at the same instant: `||` is the whole mechanism.\nstroke : Int -> Int -> Int -> [: Hammer :]\nstroke a b c = quiet a || quiet b || quiet c\n\n#: One bar of accompaniment: the same chord struck four times.\nbarOf : [: Hammer :] -> [: Hammer :]\nbarOf s = s ++ s ++ s ++ s\n\n#: The ladder itself, a bar per rung.  Read it as three columns: the top\n#: voice E–E–E–D#–D–D–C#–C, the middle B–A#–A–A–A–G#–G–G, the bass\n#: G–F#–F#–F#–F–E–E–E — never two slipping in the same bar, which is the\n#: prelude's whole method.  Then the cadence: B7 in the old register,\n#: and E minor held to let the room ring out.\nchords : [: Hammer :]\nchords = barOf (stroke 55 59 64)            # E minor\n      ++ barOf (stroke 54 58 64)            # B7 leaning in\n      ++ barOf (stroke 54 57 64)\n      ++ barOf (stroke 54 57 63)            # B7\n      ++ barOf (stroke 53 57 62)            # the chromatic passing bar\n      ++ barOf (stroke 52 56 62)            # E7, turning toward A minor\n      ++ barOf (stroke 52 55 61)\n      ++ barOf (stroke 52 55 60)            # A minor over C\n      ++ barOf (stroke 47 51 57)            # B7, low\n      ++ barOf (stroke 47 51 57)\n      ++ (stroke 52 55 59 |* 4)             # E minor, one stroke, rung out\n\n#: The sigh: B held whole bars, falling to its upper neighbour and back,\n#: then stepping down — A, G, F#, E — and closing on the leading tone\n#: before it settles.  Durations are `|*` of the one-beat note, so the\n#: line is exactly as long as the ladder under it.\ntune : [: Hammer :]\ntune = (sing 71 |* 4)\n    ++ (sing 72 |* 2) ++ (sing 71 |* 2)\n    ++ (sing 71 |* 4)\n    ++ (sing 71 |* 3) ++ sing 69\n    ++ (sing 69 |* 2) ++ (sing 67 |* 2)\n    ++ (sing 67 |* 2) ++ (sing 66 |* 2)\n    ++ (sing 66 |* 4)\n    ++ (sing 66 |* 2) ++ (sing 64 |* 2)\n    ++ (sing 64 |* 2) ++ (sing 63 |* 2)\n    ++ (sing 63 |* 4)\n    ++ (sing 64 |* 4)\n\nscore : [: Void :]\nscore = (chords || tune) >>= voices.piano\n\n# ── The mix ──────────────────────────────────────────────────────────────\n\n#: Set on the thickest beat — three tails, three strikes and the tune —\n#: and the lowpass is the felt: three overtones on seven voices is more\n#: treble than a Largo wants." "9:1:sound = gain 0.2 (lowpassOnePole 2800.0 piano)\n" #= 229 lines changed
    audition                               #= auditioning
