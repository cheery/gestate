    edit "0:1:# SAUNA NIGHT DRIVE - TEN ROOMS AFTER MIDNIGHT\n# Original 20-minute Gestate synthwave / outrun suite.\n# 500 bars at 100 BPM = exactly 1200 seconds = 20:00 of score time." "2:2:# Ten 2-minute chapters:\n#   01 Black Steam        - dark slow-burn outrun\n#   02 Neon Arcade        - brighter major-key drive\n#   03 Blue Window        - wistful lead and warm pads\n#   04 Pixel Engine       - 8-bit bass + triplet arps\n#   05 Sauna Groove       - warm rhythmic bounce\n#   06 Midnight Tunnel    - darker down-synth pressure\n#   07 Starlight Road     - uplifting arp flight\n#   08 Lonely Highway     - melancholy lead section\n#   09 Turbo Return       - aggressive outrun drive\n#   10 Cooling Stones     - emotional finale and real ending" "5:2:# Workbench:\n#   python -m gestate.workbench examples/long/sauna.ges\n# Render full 20:00 WAV, with the levels reported after it:\n#   python -m gestate.audioperform examples/long/sauna.ges -o sauna.wav --seconds 1200 --report\n#\n# The final bar has no drums. The free-running drum generator is permanently\n# muted from beat 1996 onward so the piece cannot end in an empty drum loop." "8:2:Key := Key Int Int\n\nvoices sub 2 subVoice : Sig Float\nvoices chip 3 chipVoice : Sig Float\nvoices down 2 downVoice : Sig Float\nvoices pad 5 padVoice : Sig Float\nvoices arp 4 arpVoice : Sig Float\nvoices lead 3 leadVoice : Sig Float\n\ninstance FromMIDI Key where\n    noteOn ch p v = Just (Key p v)\n\nhzOf : Key -> Float\nhzOf q = case q of\n    Key k v -> keyHz k\n\nvelOf : Key -> Float\nvelOf q = case q of\n    Key k v -> toFloat v / 127.0\n\n# ----------------------------------------------------------------------\n# SYNTH ENGINE\n# ----------------------------------------------------------------------\n\nsubVoice : Sig Gate -> Sig Key -> Sig Float\nsubVoice g s = lowpassSvf 315.0 0.17\n    (0.76 * sine (!hzOf s)\n   + 0.24 * triangle (0.5 * (!hzOf s)))\n    * adsr (Adsr 0.010 0.16 0.78 0.16) g * !velOf s\n\n# 8-bit / console-style bass and melodic pulse voice.\nchipVoice : Sig Gate -> Sig Key -> Sig Float\nchipVoice g s = drive 1.28\n    (lowpassSvf (1650.0 + 2400.0 * perc 12.0 g) 0.24\n        (0.50 * square (!hzOf s)\n       + 0.34 * pulse 0.25 (0.501 * (!hzOf s))\n       + 0.16 * triangle (0.5 * (!hzOf s))))\n    * adsr (Adsr 0.003 0.08 0.50 0.06) g * !velOf s\n\ndownVoice : Sig Gate -> Sig Key -> Sig Float\ndownVoice g s = drive 1.42\n    (lowpassLadder (150.0 + 2200.0 * perc 7.5 g) 0.48\n        (0.56 * saw (!hzOf s)\n       + 0.28 * square (0.501 * (!hzOf s))\n       + 0.16 * saw (0.994 * (!hzOf s))))\n    * adsr (Adsr 0.006 0.15 0.43 0.09) g * !velOf s\n\npadVoice : Sig Gate -> Sig Key -> Sig Float\npadVoice g s = lowpassSvf 2380.0 0.16\n    (0.36 * saw (!hzOf s)\n   + 0.28 * saw (1.006 * (!hzOf s))\n   + 0.22 * triangle (0.5 * (!hzOf s))\n   + 0.14 * pulse 0.43 (0.998 * (!hzOf s)))\n    * adsr (Adsr 0.46 0.82 0.70 1.38) g * !velOf s * 0.40\n\narpVoice : Sig Gate -> Sig Key -> Sig Float\narpVoice g s = lowpassSvf (2450.0 + 2500.0 * perc 13.0 g) 0.19\n    (0.44 * pulse 0.30 (!hzOf s)\n   + 0.30 * square (!hzOf s)\n   + 0.26 * triangle (0.5 * (!hzOf s)))\n    * perc 18.5 g * !velOf s\n\nleadVoice : Sig Gate -> Sig Key -> Sig Float\nleadVoice g s = drive 1.09\n    (lowpassSvf 3650.0 0.18\n        (0.43 * pulse 0.40 (!hzOf s)\n       + 0.31 * saw (1.003 * (!hzOf s))\n       + 0.26 * triangle (0.5 * (!hzOf s))))\n    * adsr (Adsr 0.024 0.25 0.60 0.72) g * !velOf s\n\n# ----------------------------------------------------------------------\n# HARMONIC PALETTE\n# ----------------------------------------------------------------------\n# 0 F#m, 1 D, 2 A, 3 E, 4 Bm, 5 C# major,\n# 6 C#m, 7 G, 8 Em, 9 C.\n\nroot : Int -> Int\nroot c = case c of\n    0 -> 66\n    1 -> 62\n    2 -> 69\n    3 -> 64\n    4 -> 59\n    5 -> 61\n    6 -> 61\n    7 -> 67\n    8 -> 64\n    _ -> 60\n\nthird : Int -> Int\nthird c = case c of\n    0 -> 3\n    4 -> 3\n    6 -> 3\n    8 -> 3\n    _ -> 4\n\nkn : Int -> Int -> Int -> [: Key :]\nkn c off v = '(Key (root c + off) v)\n\nbn : Int -> Int -> Int -> [: Key :]\nbn c off v = '(Key (root c - 36 + off) v)\n\nan : Int -> Int -> Int -> [: Key :]\nan c off v = '(Key (root c + 12 + off) v)\n\nln : Int -> Int -> [: Key :]\nln k v = '(Key k v)\n\npadDarkBar : Int -> [: Key :]\npadDarkBar c = (kn c 0 62 || kn c (third c) 54 || kn c 7 58 || kn c 12 48) |* 4\n\npadWarmBar : Int -> [: Key :]\npadWarmBar c = (kn c 0 66 || kn c (third c) 60 || kn c 7 64 || kn c 11 48 || kn c 12 54) |* 4\n\npadBrightBar : Int -> [: Key :]\npadBrightBar c = (kn c 0 70 || kn c (third c) 64 || kn c 7 68 || kn c 12 58 || kn c 16 48) |* 4\n\n# ----------------------------------------------------------------------\n# BASS / DOWN-SYNTH PATTERNS\n# ----------------------------------------------------------------------\n\nsubHoldBar : Int -> [: Key :]\nsubHoldBar c = bn c 0 108 |* 4\n\nsubPulseBar : Int -> [: Key :]\nsubPulseBar c = bn c 0 116 ++ bn c 0 88 ++ bn c 12 104 ++ bn c 0 96\n\nsubOctaveBar : Int -> [: Key :]\nsubOctaveBar c = (bn c 0 118 ++ bn c 12 98 ++ bn c 0 108 ++ bn c 7 92\n                ++ bn c 0 116 ++ bn c 12 94 ++ bn c 7 104 ++ bn c 0 90) |/ 2\n\nsubGrooveBar : Int -> [: Key :]\nsubGrooveBar c = (bn c 0 120 ++ bn c 0 82 ++ bn c 7 100 ++ bn c 12 94\n                ++ bn c 0 116 ++ bn c (third c) 88 ++ bn c 7 106 ++ bn c 0 92) |/ 2\n\ndownFallBar : Int -> [: Key :]\ndownFallBar c = (bn c 24 108 ++ bn c 19 92 ++ bn c 17 88 ++ bn c 12 112\n               ++ bn c 7 96 ++ bn c 5 86 ++ bn c 0 114 ++ bn c 7 90) |/ 2\n\ndownDriveBar : Int -> [: Key :]\ndownDriveBar c = (bn c 12 114 ++ bn c 7 98 ++ bn c 0 118 ++ bn c 12 92\n                ++ bn c 10 108 ++ bn c 7 94 ++ bn c 5 102 ++ bn c 0 116) |/ 2\n\n# ----------------------------------------------------------------------\n# 8-BIT / CHIP BASS PATTERNS\n# ----------------------------------------------------------------------\n\nchipSilentBar : Int -> [: Key :]\nchipSilentBar c = r |* 4\n\nchip8Bar : Int -> [: Key :]\nchip8Bar c = (bn c 12 92 ++ bn c 19 78 ++ bn c 24 96 ++ bn c 19 74\n           ++ bn c 12 88 ++ bn c 15 76 ++ bn c 19 92 ++ bn c 24 80\n           ++ bn c 12 94 ++ bn c 19 76 ++ bn c 24 98 ++ bn c 27 82\n           ++ bn c 24 90 ++ bn c 19 74 ++ bn c 15 86 ++ bn c 12 78) |/ 4\n\nchipBounceBar : Int -> [: Key :]\nchipBounceBar c = (bn c 12 88 ++ bn c 24 92 ++ bn c 19 80 ++ bn c 12 84\n                ++ bn c 15 86 ++ bn c 19 94 ++ bn c 24 88 ++ bn c 19 78) |/ 2\n\n# 12 notes /3 = four beats: true triplet motion.\nchipTripletBar : Int -> [: Key :]\nchipTripletBar c = (bn c 12 90 ++ bn c 19 80 ++ bn c 24 96\n                 ++ bn c 15 84 ++ bn c 19 90 ++ bn c 27 98\n                 ++ bn c 12 88 ++ bn c 24 94 ++ bn c 19 82\n                 ++ bn c 15 86 ++ bn c 19 92 ++ bn c 24 100) |/ 3\n\n# ----------------------------------------------------------------------\n# ARPEGGIOS\n# ----------------------------------------------------------------------\n\narpSoftBar : Int -> [: Key :]\narpSoftBar c = (an c 0 48 ++ an c (third c) 44 ++ an c 7 50 ++ an c 12 56\n             ++ an c 7 46 ++ an c (third c) 42 ++ an c 14 52 ++ an c 12 46\n             ++ an c 7 50 ++ an c (third c) 44 ++ an c 0 46 ++ an c 7 52\n             ++ an c 12 58 ++ an c 14 48 ++ an c 7 45 ++ an c (third c) 42) |/ 4\n\narpDriveBar : Int -> [: Key :]\narpDriveBar c = (an c 0 68 ++ an c 7 60 ++ an c 12 72 ++ an c (third c) 58\n              ++ an c 14 70 ++ an c 7 62 ++ an c 19 76 ++ an c 12 64\n              ++ an c 0 70 ++ an c 7 62 ++ an c 12 74 ++ an c 14 66\n              ++ an c 19 78 ++ an c 14 64 ++ an c 7 60 ++ an c (third c) 58) |/ 4\n\narpAcheBar : Int -> [: Key :]\narpAcheBar c = (an c 12 76 ++ an c 7 66 ++ an c (third c) 62 ++ an c 0 68\n             ++ an c 14 74 ++ an c 12 64 ++ an c 7 70 ++ an c (third c) 60\n             ++ an c 12 78 ++ an c 14 68 ++ an c 7 64 ++ an c 0 70\n             ++ an c (third c) 62 ++ an c 7 68 ++ an c 12 74 ++ an c 19 80) |/ 4\n\narpTripletBar : Int -> [: Key :]\narpTripletBar c = (an c 0 68 ++ an c 7 62 ++ an c 12 74\n                ++ an c (third c) 60 ++ an c 14 72 ++ an c 19 78\n                ++ an c 7 64 ++ an c 12 72 ++ an c 24 82\n                ++ an c 14 68 ++ an c 19 76 ++ an c 12 66) |/ 3\n\n# ----------------------------------------------------------------------\n# LEAD MELODIES\n# ----------------------------------------------------------------------\n\nleadMournBar : Int -> [: Key :]\nleadMournBar c = (ln (root c + 24) 90 ++ ln (root c + 19) 82\n               ++ ln (root c + 15) 86 ++ ln (root c + 14) 76\n               ++ ln (root c + 19) 88 ++ ln (root c + 15) 80\n               ++ ln (root c + 12) 84 ++ ln (root c + 19) 80) |/ 2\n\nleadLiftBar : Int -> [: Key :]\nleadLiftBar c = (ln (root c + 12) 82 ++ ln (root c + 19) 88\n              ++ ln (root c + 24) 94 ++ ln (root c + 26) 86\n              ++ ln (root c + 24) 92 ++ ln (root c + 19) 82\n              ++ ln (root c + 16) 86 ++ ln (root c + 19) 84) |/ 2\n\nleadFallingBar : Int -> [: Key :]\nleadFallingBar c = ln (root c + 31) 94\n                ++ ln (root c + 26) 88\n                ++ ln (root c + 24) 86\n                ++ ln (root c + 19) 80\n\nleadArcadeBar : Int -> [: Key :]\nleadArcadeBar c = (ln (root c + 19) 88 ++ ln (root c + 24) 94\n                ++ ln (root c + 31) 98 ++ ln (root c + 28) 88\n                ++ ln (root c + 26) 92 ++ ln (root c + 24) 86\n                ++ ln (root c + 19) 90 ++ ln (root c + 24) 94) |/ 2\n\nleadTurboBar : Int -> [: Key :]\nleadTurboBar c = (ln (root c + 24) 98 ++ ln (root c + 31) 102\n               ++ ln (root c + 26) 92 ++ ln (root c + 24) 96\n               ++ ln (root c + 19) 88 ++ ln (root c + 26) 94\n               ++ ln (root c + 31) 104 ++ ln (root c + 36) 100) |/ 2\n\nleadResolveBar : [: Key :]\nleadResolveBar = ln 78 88 ++ ln 73 84 ++ ln 69 82 ++ ln 66 104\n\n# ----------------------------------------------------------------------\n# TEN 10-BAR CELLS; each chapter cycles its cell inside a 200-beat box.\n# `long 200` clips the lazy cycle after exactly 50 bars.\n# ----------------------------------------------------------------------\n\nh1 : [: Int :]\nh1 = '0 ++ '1 ++ '4 ++ '5 ++ '0 ++ '3 ++ '1 ++ '5 ++ '4 ++ '5\n\nh2 : [: Int :]\nh2 = '2 ++ '3 ++ '0 ++ '1 ++ '2 ++ '3 ++ '1 ++ '5 ++ '2 ++ '3\n\nh3 : [: Int :]\nh3 = '0 ++ '3 ++ '1 ++ '2 ++ '4 ++ '1 ++ '5 ++ '0 ++ '3 ++ '5\n\nh4 : [: Int :]\nh4 = '6 ++ '2 ++ '3 ++ '6 ++ '1 ++ '2 ++ '5 ++ '6 ++ '3 ++ '5\n\nh5 : [: Int :]\nh5 = '2 ++ '3 ++ '7 ++ '1 ++ '2 ++ '4 ++ '3 ++ '1 ++ '5 ++ '2\n\nh6 : [: Int :]\nh6 = '8 ++ '9 ++ '7 ++ '4 ++ '8 ++ '1 ++ '5 ++ '0 ++ '4 ++ '5\n\nh7 : [: Int :]\nh7 = '2 ++ '1 ++ '0 ++ '3 ++ '2 ++ '1 ++ '4 ++ '5 ++ '2 ++ '3\n\nh8 : [: Int :]\nh8 = '4 ++ '1 ++ '0 ++ '3 ++ '4 ++ '1 ++ '5 ++ '0 ++ '3 ++ '5\n\nh9 : [: Int :]\nh9 = '0 ++ '5 ++ '1 ++ '3 ++ '0 ++ '4 ++ '1 ++ '5 ++ '0 ++ '5\n\nh10 : [: Int :]\nh10 = '1 ++ '2 ++ '0 ++ '3 ++ '4 ++ '1 ++ '5 ++ '0 ++ '3 ++ '5\n\n# ----------------------------------------------------------------------\n# ARRANGEMENT - 500 bars exactly\n# ----------------------------------------------------------------------\n\nsubPart : [: Key :]\nsubPart = long 200 (cycle (h1 >>= subHoldBar))\n       ++ long 200 (cycle (h2 >>= subOctaveBar))\n       ++ long 200 (cycle (h3 >>= subHoldBar))\n       ++ long 200 (cycle (h4 >>= subPulseBar))\n       ++ long 200 (cycle (h5 >>= subGrooveBar))\n       ++ long 200 (cycle (h6 >>= subHoldBar))\n       ++ long 200 (cycle (h7 >>= subOctaveBar))\n       ++ long 200 (cycle (h8 >>= subPulseBar))\n       ++ long 200 (cycle (h9 >>= subGrooveBar))\n       ++ long 196 (cycle (h10 >>= subPulseBar))\n       ++ (bn 0 0 124 |* 4)\n\nchipPart : [: Key :]\nchipPart = (r |* 200)\n        ++ long 200 (cycle (h2 >>= chipBounceBar))\n        ++ (r |* 200)\n        ++ long 200 (cycle (h4 >>= chip8Bar))\n        ++ long 200 (cycle (h5 >>= chipBounceBar))\n        ++ (r |* 200)\n        ++ long 200 (cycle (h7 >>= chipTripletBar))\n        ++ (r |* 200)\n        ++ long 200 (cycle (h9 >>= chip8Bar))\n        ++ long 196 (cycle (h10 >>= chipTripletBar))\n        ++ (ln 54 96 |* 4)\n\ndownPart : [: Key :]\ndownPart = long 200 (cycle (h1 >>= downFallBar))\n        ++ long 200 (cycle (h2 >>= downDriveBar))\n        ++ long 200 (cycle (h3 >>= downFallBar))\n        ++ long 200 (cycle (h4 >>= downDriveBar))\n        ++ long 200 (cycle (h5 >>= downDriveBar))\n        ++ long 200 (cycle (h6 >>= downFallBar))\n        ++ long 200 (cycle (h7 >>= downDriveBar))\n        ++ long 200 (cycle (h8 >>= downFallBar))\n        ++ long 200 (cycle (h9 >>= downDriveBar))\n        ++ long 196 (cycle (h10 >>= downFallBar))\n        ++ (ln 42 108 |* 4)\n\npadPart : [: Key :]\npadPart = long 200 (cycle (h1 >>= padDarkBar))\n       ++ long 200 (cycle (h2 >>= padBrightBar))\n       ++ long 200 (cycle (h3 >>= padWarmBar))\n       ++ long 200 (cycle (h4 >>= padDarkBar))\n       ++ long 200 (cycle (h5 >>= padWarmBar))\n       ++ long 200 (cycle (h6 >>= padDarkBar))\n       ++ long 200 (cycle (h7 >>= padBrightBar))\n       ++ long 200 (cycle (h8 >>= padWarmBar))\n       ++ long 200 (cycle (h9 >>= padDarkBar))\n       ++ long 196 (cycle (h10 >>= padWarmBar))\n       ++ ((kn 0 0 68 || kn 0 3 58 || kn 0 7 62 || kn 0 12 54) |* 4)\n\narpPart : [: Key :]\narpPart = long 200 (cycle (h1 >>= arpSoftBar))\n       ++ long 200 (cycle (h2 >>= arpDriveBar))\n       ++ long 200 (cycle (h3 >>= arpAcheBar))\n       ++ long 200 (cycle (h4 >>= arpTripletBar))\n       ++ long 200 (cycle (h5 >>= arpDriveBar))\n       ++ long 200 (cycle (h6 >>= arpSoftBar))\n       ++ long 200 (cycle (h7 >>= arpTripletBar))\n       ++ long 200 (cycle (h8 >>= arpAcheBar))\n       ++ long 200 (cycle (h9 >>= arpDriveBar))\n       ++ long 196 (cycle (h10 >>= arpAcheBar))\n       ++ (an 0 12 84 ++ an 0 7 76 ++ an 0 3 72 ++ an 0 0 88)\n\nleadPart : [: Key :]\nleadPart = long 200 (cycle (h1 >>= leadMournBar))\n        ++ long 200 (cycle (h2 >>= leadArcadeBar))\n        ++ long 200 (cycle (h3 >>= leadFallingBar))\n        ++ long 200 (cycle (h4 >>= leadArcadeBar))\n        ++ long 200 (cycle (h5 >>= leadLiftBar))\n        ++ long 200 (cycle (h6 >>= leadMournBar))\n        ++ long 200 (cycle (h7 >>= leadLiftBar))\n        ++ long 200 (cycle (h8 >>= leadFallingBar))\n        ++ long 200 (cycle (h9 >>= leadTurboBar))\n        ++ long 196 (cycle (h10 >>= leadMournBar))\n        ++ leadResolveBar\n\n# ----------------------------------------------------------------------\n# DRUM MACHINE - section-aware grooves and recurring brakes\n# ----------------------------------------------------------------------\n\nkickEnv : Sig Float\nkickEnv = map (b => exp (negate 18.0 * wrap b)) beat\n\nkick : Sig Float\nkick = (0.88 * sine (44.0 + 135.0 * kickEnv)\n      + 0.12 * triangle (88.0 + 58.0 * kickEnv)) * kickEnv\n\nsnareEnv : Sig Float\nsnareEnv = map (b => exp (negate 12.5 * wrap ((b + 1.0) / 2.0))) beat\n\nsnare : Sig Float\nsnare = (0.67 * highpassSvf 1550.0 0.20 (white 201)\n       + 0.23 * triangle 182.0) * snareEnv\n\nhatEnv : Sig Float\nhatEnv = map (b => exp (negate 62.0 * wrap (2.0 * b))) beat\n\nhats : Sig Float\nhats = highpassSvf 7250.0 0.14 (white 203) * hatEnv * 0.22\n\nhat16Env : Sig Float\nhat16Env = map (b => exp (negate 54.0 * wrap (4.0 * b))) beat\n\nhats16 : Sig Float\nhats16 = highpassSvf 7900.0 0.12 (white 205) * hat16Env * 0.10\n\nopenHatEnv : Sig Float\nopenHatEnv = map (b => exp (negate 9.0 * wrap ((b + 0.5) / 2.0))) beat\n\nopenHat : Sig Float\nopenHat = highpassSvf 6500.0 0.15 (white 207) * openHatEnv * 0.11\n\nclapEnv : Sig Float\nclapEnv = map (b => exp (negate 18.0 * wrap ((b + 1.0) / 2.0))) beat\n\nclap : Sig Float\nclap = highpassSvf 2100.0 0.18 (white 211) * clapEnv * 0.17\n\nfillEnv : Sig Float\nfillEnv = map (b => exp (negate 31.0 * wrap (4.0 * b))) beat\n\nfillNoise : Sig Float\nfillNoise = (0.60 * highpassSvf 1250.0 0.20 (white 213)\n           + 0.16 * triangle 154.0) * fillEnv\n\nbarOfBeat : Float -> Int\nbarOfBeat b = floor (b / 4.0)\n\nlocalBar : Float -> Int\nlocalBar b = prim_mod_int (barOfBeat b) 50\n\nsectionOfBar : Float -> Int\nsectionOfBar b = floor (toFloat (barOfBeat b) / 50.0)\n\nstep16OfBeat : Float -> Int\nstep16OfBeat b = prim_mod_int (floor (4.0 * b)) 16\n\nbeatOfBar : Float -> Int\nbeatOfBar b = prim_mod_int (floor b) 4\n\nfirstHalfStep : Int -> Float\nfirstHalfStep s = case s of\n    0 -> 1.0\n    1 -> 1.0\n    2 -> 1.0\n    3 -> 1.0\n    4 -> 1.0\n    5 -> 1.0\n    6 -> 1.0\n    7 -> 1.0\n    _ -> 0.0\n\nlastHalfStep : Int -> Float\nlastHalfStep s = case s of\n    8 -> 1.0\n    9 -> 1.0\n    10 -> 1.0\n    11 -> 1.0\n    12 -> 1.0\n    13 -> 1.0\n    14 -> 1.0\n    15 -> 1.0\n    _ -> 0.0\n\n# Three short brake bars in every 50-bar chapter.\nbreakGateAt : Float -> Float\nbreakGateAt b = case localBar b of\n    15 -> firstHalfStep (step16OfBeat b)\n    31 -> firstHalfStep (step16OfBeat b)\n    47 -> firstHalfStep (step16OfBeat b)\n    _ -> 1.0\n\nfillGateAt : Float -> Float\nfillGateAt b = case localBar b of\n    15 -> lastHalfStep (step16OfBeat b)\n    31 -> lastHalfStep (step16OfBeat b)\n    47 -> lastHalfStep (step16OfBeat b)\n    _ -> 0.0\n\n# Different kick weight per 2-minute chapter creates different grooves.\nkickSectionAt : Float -> Float\nkickSectionAt b = case sectionOfBar b of\n    0 -> case beatOfBar b of\n        0 -> 1.0\n        2 -> 0.92\n        _ -> 0.46\n    1 -> 1.0\n    2 -> case beatOfBar b of\n        0 -> 1.0\n        2 -> 0.90\n        _ -> 0.18\n    3 -> 1.0\n    4 -> case beatOfBar b of\n        0 -> 1.0\n        1 -> 0.68\n        2 -> 0.96\n        _ -> 0.74\n    5 -> case beatOfBar b of\n        0 -> 1.0\n        2 -> 0.94\n        _ -> 0.28\n    6 -> 1.0\n    7 -> case beatOfBar b of\n        0 -> 1.0\n        2 -> 0.88\n        _ -> 0.22\n    8 -> 1.0\n    _ -> case beatOfBar b of\n        0 -> 1.0\n        1 -> 0.76\n        2 -> 1.0\n        _ -> 0.82\n\nhat16SectionAt : Float -> Float\nhat16SectionAt b = case sectionOfBar b of\n    3 -> 1.0\n    6 -> 0.72\n    8 -> 1.0\n    9 -> 0.54\n    _ -> 0.0\n\nopenHatSectionAt : Float -> Float\nopenHatSectionAt b = case sectionOfBar b of\n    1 -> 1.0\n    4 -> 0.86\n    6 -> 0.92\n    8 -> 1.0\n    9 -> 0.72\n    _ -> 0.30\n\n# Final bar begins at beat 1996. Mute drums permanently there and beyond.\ndrumMasterAt : Float -> Float\ndrumMasterAt b = case b < 1996.0 of\n    True -> 1.0\n    False -> 0.0\n\ndrumMaster : Sig Float\ndrumMaster = map (b => drumMasterAt b) beat\n\nkickDrive : Sig Float\nkickDrive = kick * drumMaster * map (b => kickSectionAt b * breakGateAt b) beat\n\nsnareDrive : Sig Float\nsnareDrive = snare * drumMaster * map (b => breakGateAt b) beat\n\nhatDrive : Sig Float\nhatDrive = hats * drumMaster * map (b => breakGateAt b) beat\n\nhat16Drive : Sig Float\nhat16Drive = hats16 * drumMaster * map (b => hat16SectionAt b * breakGateAt b) beat\n\nopenHatDrive : Sig Float\nopenHatDrive = openHat * drumMaster * map (b => openHatSectionAt b * breakGateAt b) beat\n\nclapDrive : Sig Float\nclapDrive = clap * drumMaster * map (b => breakGateAt b) beat\n\nfillRoll : Sig Float\nfillRoll = fillNoise * drumMaster * map (b => fillGateAt b) beat\n\npump : Sig Float\npump = map (b => 0.36 + 0.64 * (1.0 - exp (negate 4.8 * wrap b))) beat\n\n# ----------------------------------------------------------------------\n# SCORE\n# ----------------------------------------------------------------------\n\nscore : [: Void :]\nscore = (subPart >>= voices.sub)\n     || (chipPart >>= voices.chip)\n     || (downPart >>= voices.down)\n     || (padPart >>= voices.pad)\n     || (arpPart >>= voices.arp)\n     || (leadPart >>= voices.lead)\n\nbpm : Int\nbpm = 100\n\n# ----------------------------------------------------------------------\n# MIX - warm sauna-night stereo field\n# ----------------------------------------------------------------------\n\nsubPump : Sig Float\nsubPump = (0.68 + 0.32 * pump) * sub\n\nchipPump : Sig Float\nchipPump = (0.60 + 0.40 * pump) * chip\n\ndownPump : Sig Float\ndownPump = (0.54 + 0.46 * pump) * down\n\npadPump : Sig Float\npadPump = pump * pad\n\narpPump : Sig Float\narpPump = (0.58 + 0.42 * pump) * arp\n\nleadPump : Sig Float\nleadPump = (0.70 + 0.30 * pump) * lead\n\narpEcho : Sig Float\narpEcho = echo 0.300 0.42 arpPump\n\nleadEcho : Sig Float\nleadEcho = echo 0.450 0.42 leadPump\n\nchipEcho : Sig Float\nchipEcho = echo 0.150 0.24 chipPump\n\ndownEcho : Sig Float\ndownEcho = echo 0.200 0.18 downPump\n\nroom : Sig Float\nroom = reverb 2.35 0.48\n    (0.28 * snareDrive\n   + 0.14 * clapDrive\n   + 0.17 * fillRoll\n   + 0.24 * padPump\n   + 0.15 * arpPump\n   + 0.20 * leadPump)\n\ncentre : Sig Float\ncentre = 0.88 * kickDrive\n       + 0.56 * snareDrive\n       + 0.11 * clapDrive\n       + 0.76 * subPump\n       + 0.63 * downPump\n       + 0.30 * chipPump\n       + 0.20 * room\n\n#: **Headroom, measured rather than guessed.**  The mix below sums\n#: fifteen sources and peaked at **3.5** before this constant existed\n#: — nearly four times full scale — so `brickwall` was not the safety\n#: net it looks like, it was the mixing desk: a fifth of every chapter\n#: sat pinned exactly at the ceiling, and all ten chapters came out at\n#: the same loudness (RMS 0.44, spread 0.011) however differently they\n#: were written.  That is what a limiter does when it is asked to do\n#: the arranging.\n#:\n#: One number fixes it and changes nothing else: every balance below\n#: is the author's, untouched, and this only decides where the sum\n#: sits under the ceiling.  At 0.30 the peak lands near 1.05, so the\n#: brickwall catches transients — which is its job — and the chapters\n#: are free to differ again.\n#:\n#: For anyone with ears who wants to go further: the bass group\n#: (`sub` + `chip` + `down`) measures peak 1.85 and RMS 0.394 on its\n#: own, against 0.88/0.264 for the pad-arp-lead tops.  Whether the\n#: floor should carry that much of the piece is a judgement no meter\n#: can make, which is why it is written here and not changed.\nmaster : Float\nmaster = 0.30\n\nsound : Sig Stereo\nsound = pair\n    (brickwall 0.89 (gain master\n        (centre\n       + 0.27 * hatDrive\n       + 0.12 * hat16Drive\n       + 0.11 * openHatDrive\n       + 0.17 * fillRoll\n       + 0.24 * chipEcho\n       + 0.24 * downEcho\n       + 0.36 * arpPump\n       + 0.22 * arpEcho\n       + 0.42 * leadPump\n       + 0.24 * leadEcho\n       + 0.52 * chorus 0.24 0.47 padPump)))\n    (brickwall 0.89 (gain master\n        (centre\n       + 0.23 * hatDrive\n       + 0.14 * hat16Drive\n       + 0.15 * openHatDrive\n       + 0.17 * fillRoll\n       + 0.16 * chipEcho\n       + 0.16 * downEcho\n       + 0.34 * arpPump\n       + 0.35 * arpEcho\n       + 0.42 * leadPump\n       + 0.40 * leadEcho\n       + 0.52 * chorus 0.37 0.47 padPump)))" #= 676 lines changed
    # 1 look
    ask exportWav 0 Path ""                #= 3 rows 05d91d0b31ffec4b
    exportWav "sauna.wav"                  #= exporting sauna.wav…
