# audio.ges — the vocabulary a synth is written in.
#
# **Not part of the core prelude**, for the reason `music.ges` and `gui.ges`
# are not.  The audio backend prepends it.
#
# A synth program supplies `sound : Sig Float` — samples in -1.0 .. 1.0, one
# per instant — and `gestate/audio.py` unrolls it to a `.wav`.
#
# For more than one channel it supplies a signal of a **record whose fields
# are all `Float`** instead: `Stereo := Stereo Float Float` is left then
# right, because field order is channel order.  Nothing here declares that
# type — a frame is the program's own, and a bank of stereo voices sums
# componentwise without any of this having to know.  See
# `examples/audio/stereo.ges`.
#
# This is **offline**, and deliberately so.  A gestate signal evaluated per
# sample is two or three orders of magnitude short of 48 kHz in real time,
# and a faster interpreter would not close that gap — audio DSP wants flat
# buffers and no allocation, which is not what graph reduction is.  The
# split SuperCollider makes is the right one: a language *describes* the
# instrument and something else runs it.  Rendering to a file is the half
# that needs no engine, and it is enough to find out whether the language
# says what a synth is well.
#
# `sampleRate` is supplied by the renderer, not written here — and it is a
# `Float`, because that is what every use of it wants.  It was an `Int`
# with a `sampleRateF = toFloat sampleRate` beside it, which is one name
# too many and the second of them wearing its type: a program that wanted
# a count of samples now says `seconds 0.25` or `floor (sampleRate / …)`,
# and the four examples that said `prim_div_int sampleRate speed` say
# arithmetic instead.

# ── Time ─────────────────────────────────────────────────────────────────

clock : Chan Int
clock = chan

#: The sample index — 0, 1, 2, … — one instant per sample.  A synth reads
#: its own position in time off this rather than counting.
ticks : Sig Int
ticks = 0 ::: mkSig (wait clock)

#: Seconds as a number of samples.
seconds : Float -> Int
seconds t = floor (t * sampleRate)

#: **How long the program has been running, in seconds.**  The clock a
#: piece with no score has.
#:
#: `beat` is the other one and is a *score's* — it needs a `bpm`, so an
#: unscored synth naming it is told there is no tempo to answer with.  A
#: drone, a soundscape or anything else that varies over its own duration
#: rather than over a bar wants this instead, and `on <points> elapsed` is
#: what reading an envelope against it looks like.
elapsed : Sig Float
elapsed = map (n => toFloat n / sampleRate) ticks

# ── Signals ─────────────────────────────────────────────────────────────
#
# `mkSig`, `map`, `scan`, `zipSig`, `addSig` and `gain` come from
# `gestate/signal.ges`, which the backend prepends before this file.

# `constSig` — a signal that is always `v` — is **the renderer's**, like
# `sampleRate`, and for the same reason: what a signal is constant *over*
# is a clock, and which clock there is depends on who is running the
# program.  The audio renderer gives one over `ticks`; the canvas gives one
# over `events`.  `!x` with no arguments desugars to it.

# ── Signals are numbers ──────────────────────────────────────────────────
#
# **The one that changes how a synth reads.**  `spec/frp_lesson.md` puts
# Fran beside this language and the difference is not the combinators, it
# is that in Fran a behaviour is a value: `stretch (abs wiggle) charlotte`
# applies ordinary functions to something that varies, and nowhere says so.
# Here the same thought had to be spelled `zipSig (x y => x * y) tone env`
# — the plumbing named at every join, in code whose subject is the sound.
#
# It need not be.  `+`, `-` and `*` are `Num`'s methods, an instance is
# ordinary code, and `addSig`/`subSig`/`mulSig` were already written next
# door: `tone * env` is a definition away, and it is *the same graph* — the
# instance is where the `zipSig` went, not an interpretation layer.
#
# What it cost was one gap in the compiler rather than any new machinery:
# a generated method supercombinator carried no type, so the audio fragment
# — which asks every definition its type — could not judge one and refused
# them all by the name of their instance head.  `elaborate._method_type`
# is that gap, closed.
instance Num (Sig Float) where
    #: What a bare number means beside a signal: the same number, always.
    #: `tone * 2` is `tone` twice as loud.
    fromInteger n = constSig (toFloat n)
    (+) a b = addSig a b
    (-) a b = subSig a b
    (*) a b = mulSig a b

#: And the same for a literal with a point in it, which is the one a synth
#: actually writes: `0.5 + wiggle * 0.25` is the shape it looks like.
instance Floating (Sig Float) where
    fromFloat x = constSig x

# ── Building blocks ──────────────────────────────────────────────────────

# ── Parameters ───────────────────────────────────────────────────────────
#
# A **control-rate** channel: a second clock, ticking once per block rather
# than once per sample, which is what a knob costs a few instructions per
# block instead of per sample.  `spec/liveaudio.md` §"Two clocks" is where
# that became `.kr` and `.ar`.
#
# The long form is a channel and a `:::`:
#
#     levelChan : Chan Float
#     levelChan = chan
#
#     level : Sig Float
#     level = 0.6 ::: mkSig (wait levelChan)
#
# `mkKnob` is the same thing in one line, and the channel it makes has no
# name a program can say — which is the point rather than a shortcut: the
# *definition* is what an environment places a slider beside and what the
# person turning it thinks they are turning, so a second name for it was
# only ever an opportunity for the two to disagree.  `twoknobs.ges` writes
# the long form out, because a file about what a channel *is* should.
#
# Named `mkKnob` and not `knob` for the reason `mkSig` is named that way: a
# program is entitled to call its own parameter `knob`, and
# `examples/audio/knob.ges` does.  A prelude that took the obvious noun
# would have made that file stop compiling, and a name a user cannot use
# is a name badly chosen — the audio prelude is prepended as *text*, so
# there is no shadowing to fall back on the way `prelude.ges` has.

#: A parameter, and what it holds before anything arrives.
#:
#: **Polymorphic, and it took a change to the fragment to be.**  A signal
#: definition is *inlined* at every use, at that use's own type, so a
#: `mkKnob 0.6` is a `Float` channel and a `mkKnob 40` an `Int` one and no
#: `a` survives into the graph.  The checker used to judge a definition by
#: its declared type rather than by what becomes of it, and refused this —
#: `fixme.md` F96's mistake in a second place — so there were two names,
#: `mkKnob` and `mkKnobInt`, for one idea.
#:
#: The type decides the slider an environment draws: a `Float` runs
#: 0.0 .. 1.0, because every `Float` a synth takes a knob for is already a
#: fraction, and an `Int` runs 0 .. 100.
mkKnob : a -> Sig a
mkKnob v = v ::: mkSig (wait chan)



#: **Fractional part.**  Keeps an accumulating phase inside 0.0 .. 1.0.
#:
#: A class because the convention says a plain verb is *a transformation,
#: at whatever type*, and this one had been a transformation at exactly one
#: — so `wrap` over a signal meant writing the `map` out.  `synth.ges` adds
#: the two stereo instances, where `Stereo` is declared.
class Wrap a where
    wrap : a -> a

instance Wrap Float where
    wrap p = p - toFloat (floor p)

instance Wrap (Sig Float) where
    wrap s = map wrap s

#: A rising ramp 0..1 becomes a sawtooth -1..1.
sawOf : Float -> Float
sawOf p = 2.0 * p - 1.0

#: A square, from the same phase.
squareOf : Float -> Float
squareOf p = case p < 0.5 of
    True -> 1.0
    False -> negate 1.0

#: A triangle, from the same phase — gentler than either.
triangleOf : Float -> Float
triangleOf p = case p < 0.5 of
    True -> 4.0 * p - 1.0
    False -> 3.0 - 4.0 * p

#: Turns, not radians.  One place for 2π, and the same 0..1 phase every
#: other oscillator here takes — so `sineOf` substitutes for `sawOf` in any
#: chain rather than needing its own convention.
tau : Float
tau = 6.283185307179586

#: A sine, from the same phase.  The one oscillator that is not arithmetic
#: on a ramp, and the reason `spec/liveaudio.md`'s open question 2 had to
#: be answered before it could exist.
sineOf : Float -> Float
sineOf p = sin (tau * p)

#: **When** a note began and when it was released — half of what a
#: `voices` bank hands a voice, the other half being the program's own
#: payload.
#:
#: The two arrive as *two signals*: `voice : Sig Gate -> Sig Key -> Sig
#: Float`.  They used to arrive as one, `Sig (Played Key)` with
#: `Played a := Played Int Int a`, and every voice began by taking that
#: record apart to get at whichever half it wanted — an envelope wants the
#: timing and a pitch wants the payload, and almost nothing wants both.
#: The bank had them apart already: `gateAt` and `offAt` are channels of
#: their own, and the bundling was work it did on the way out.  So the
#: split removes a record, two zips per voice and a projection from every
#: instrument (`spec/frp_lesson.md`).
#:
#: Both are **1-based** sample indices, and zero means *nothing*: `on = 0`
#: is a voice that has never played, `off = 0` one that is still held.  That
#: is what makes an untouched bank silent from its channels' own defaults,
#: with nothing a host must remember to send.
Gate := Gate Int Int

#: How a MIDI note becomes a bank's payload — and whether it does at all.
#:
#: `Nothing` **declines** the note, which is what makes this one method
#: rather than a routing table beside it: a bank that only wants channel 2,
#: or only the notes below middle C, says so here in ordinary code.
#:
#: It says the payload *can* come from MIDI, not that a given bank listens.
#: Two banks may carry the same payload — `duet.ges`'s `lead` and `bass`
#: both carry `Pitched` — so they share this instance and nothing in the
#: type could tell them apart.  Which of them listens is the environment's
#: switch, not the program's.
#: `noteOn channel pitch velocity`.
class FromMIDI a where
    noteOn : Int -> Int -> Int -> Maybe a

#: A one-pole lowpass, as a *signal transformation*.  A coefficient near 0
#: is very smooth, near 1 lets everything through.  This is the shape the whole
#: design is for: a signal in, a signal out, state held by `scan`.
#:
#: The coefficient is a signal, and a number is one — `lowpass 0.1 s` is
#: the fixed filter it always was, and a coefficient an envelope moves is
#: the same function.  A `Float`-typed expression needs the lift: `lowpass
#: (!k) s`.
lowpass : Sig Float -> Sig Float -> Sig Float
lowpass k s = scan lowpassNext 0.0 (zipSig (x c => LowpassIn x c) s k)

#: **Keep a sample in range** — hard-limit it to -1.0 .. 1.0, which is
#: what a renderer can write and anything beyond is what a renderer
#: clips for you, badly.
#:
#: A class for the reason `wrap` is one, and `synth.ges` adds the stereo
#: instances beside it.  `softClip` is the version that curves into the
#: limit instead of cornering at it.
class Clip a where
    clip : a -> a

instance Clip Float where
    clip x = case x < negate 1.0 of
        True -> negate 1.0
        False -> case x > 1.0 of
            True -> 1.0
            False -> x

instance Clip (Sig Float) where
    clip s = map clip s

# ── Envelopes ────────────────────────────────────────────────────────────
#
# A curve given as breakpoints, read at a point.  `Step b y` steps to `y`
# at `b`, holding whatever came before right up to it; `Ramp b y` slides to
# `y`, arriving exactly at `b`.  The flag rides on the point being *arrived
# at*, so "reach 0.8 by beat 16" says nothing about beat 17.
#
# **Total: it never fails.**  Before the first point it reads the first
# value and after the last it reads the last.  Its argument is nearly
# always a clock — a beat, an age, a position — and a clock will run past
# the end of any envelope written for it, so refusing there would put a
# `clamp` that says nothing at every call site, and extrapolating would
# send a filter cutoff to infinity ten seconds after the note ended.
#
# **This definition is the meaning, not the implementation.**  It walks a
# cons list, which the static audio fragment refuses — no fixed size — so
# `gestate/envexpand.py` rewrites `on <points> x` into a balanced tree of
# comparisons over the breakpoints, which is flat and first-order and is
# what actually runs in a synth.  This is what that rewrite is checked
# against, and it is what an interpreted program runs unchanged.

Envelope := Step Float Float
          | Ramp Float Float

#: What the envelope reads at `x`.
on : List Envelope -> Float -> Float
on ps x = case ps of
    [] -> 0.0
    (p :: rest) -> case p of
        Step b y -> onFrom b y rest x
        Ramp b y -> onFrom b y rest x

# ── The beat clock under a tempo envelope ────────────────────────────────
#
# `beat` is linear when the tempo is a plain `bpm`, and a piecewise
# *quadratic* when it is an envelope: tempo is linear in time, so beat —
# its integral — is one degree higher.  That is the same fact that makes
# "when does beat 48 happen" invertible in closed form (`gestate/tempo.py`).
#
# **This definition is the meaning, not the implementation.**  It walks a
# cons list, which the static audio fragment refuses, so `envexpand.py`
# rewrites `beatOf <points> t` into a balanced tree over the segment
# boundaries with `a + b·t + c·t²` at each leaf.  This is what that rewrite
# is checked against, and it is what an interpreted program runs.

#: What beat it is, `t` seconds in.
beatOf : List Envelope -> Float -> Float
beatOf ps t = case ps of
    [] -> 0.0
    (p :: rest) -> beatOpen (envAt p) (envVal p) rest t

internal

#: `lowpass`'s sample and coefficient arriving together — a zip needs a
#: carrier and a tuple has no layout in the fragment.
LowpassIn := LowpassIn Float Float

#: `lowpass`, one sample: the state chases `x` by `c` of the distance.
lowpassNext : Float -> LowpassIn -> Float
lowpassNext y p = case p of
    LowpassIn x c -> y + c * (x - y)

#: The walk, once the first point has been opened: `b`/`y` are the point
#: behind us and `rest` is what is still ahead.
onFrom : Float -> Float -> List Envelope -> Float -> Float
onFrom b y rest x = case x <= b of
    True -> y
    False -> case rest of
        [] -> y
        (p :: more) -> case p of
            Step c z -> case x < c of
                True -> y
                False -> onFrom c z more x
            Ramp c z -> case x < c of
                True -> onRamp b y c z x
                False -> onFrom c z more x

#: One linear segment, between two points.
onRamp : Float -> Float -> Float -> Float -> Float -> Float
onRamp b y c z x = case c - b <= 0.0 of
    True -> z
    False -> y + (z - y) * (x - b) / (c - b)


envAt : Envelope -> Float
envAt p = case p of
    Step b y -> b
    Ramp b y -> b

envVal : Envelope -> Float
envVal p = case p of
    Step b y -> y
    Ramp b y -> y

envRamps : Envelope -> Bool
envRamps p = case p of
    Step b y -> False
    Ramp b y -> True

#: Before the first point the tempo is the first tempo, held — so the beat
#: clock is linear there, and the first point falls at `60·b₀/y₀`.
beatOpen : Float -> Float -> List Envelope -> Float -> Float
beatOpen b0 y0 rest t = case y0 <= 0.0 of
    True -> 0.0
    False -> case t * y0 / 60.0 < b0 of
        True -> t * y0 / 60.0
        False -> beatWalk (60.0 * b0 / y0) b0 y0 rest t

#: One segment at a time, carrying where it starts in *both* coordinates.
#: `dt` is the trapezoid — a linear ramp covers its beats in the time its
#: mean tempo would — and `k` is the slope in bpm per second.
beatWalk : Float -> Float -> Float -> List Envelope -> Float -> Float
beatWalk t0 b0 y0 rest t = case rest of
    [] -> b0 + y0 / 60.0 * (t - t0)
    (q :: more) -> beatSeg t0 b0 y0 (envAt q) (envVal q) (envRamps q) more t

beatSeg : Float -> Float -> Float -> Float -> Float -> Bool -> List Envelope
        -> Float -> Float
beatSeg t0 b0 y0 b1 y1 ramps more t = let d = beatDt b0 y0 b1 y1 ramps in beatIn t0 b0 y0 d (beatK y0 y1 d ramps) b1 y1 more t

beatDt : Float -> Float -> Float -> Float -> Bool -> Float
beatDt b0 y0 b1 y1 ramps = case ramps of
    True -> 120.0 * (b1 - b0) / (y0 + y1)
    False -> 60.0 * (b1 - b0) / y0

beatK : Float -> Float -> Float -> Bool -> Float
beatK y0 y1 dt ramps = case ramps of
    False -> 0.0
    True -> case dt <= 0.0 of
        True -> 0.0
        False -> (y1 - y0) / dt

beatIn : Float -> Float -> Float -> Float -> Float -> Float -> Float
       -> List Envelope -> Float -> Float
beatIn t0 b0 y0 dt k b1 y1 more t = case t < t0 + dt of
    True -> b0 + y0 / 60.0 * (t - t0) + k / 120.0 * (t - t0) * (t - t0)
    False -> beatWalk (t0 + dt) b1 y1 more t
