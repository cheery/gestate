# doc/trial/reactors/drag-today.ges — the same three dots as
# `examples/gui/drag.ges`, written without reactor blocks: the same
# `Holds` and the same document, each dot's channel, fold and picture
# written by hand.  The control for the places-touched count,
# `card:gui-is-difficult.md` §"Built — a drag, as a reactor with a
# stored mode".

include "drag-today.dots"

names : List Text
names = "a" :: "b" :: "c" :: Nil

dotRel : Rel
dotRel = Rel "dot" (Col "name" (OneOf names) :: Col "x" (Range (0 - 200) 200) :: Nil) ("name" :: Nil)

dotLine : Line
dotLine = Line "dot" Named ("name" :: "x" :: Nil) (By "name" :: Nil)

model : List Rel
model = dotRel :: Nil

lines : List Line
lines = dotLine :: Nil

type Dot = $(rowType dotRel)
type Dots = Set Dot

dots : Sig Dots
dots = document "dot"

xOf : Dots -> Text -> Int
xOf ds k = case elems (for ((n, x) in ds, n == k) {x}) of
    [] -> 0
    x :: rest -> x

clampX : Int -> Int
clampX x = case x < 0 - 200 of
    True -> 0 - 200
    False -> case x > 200 of
        True -> 200
        False -> x

restInk : Colour
restInk = RGB 235 178 110

heldInk : Colour
heldInk = RGB 255 220 160

textInk : Colour
textInk = RGB 30 30 36

trackInk : Colour
trackInk = RGB 38 42 52

disc : Text -> Colour -> Sub
disc label ink = Over (Circle 14 ink) (Label 12 12 label textInk)

track : Sub
track = Rect 440 4 trackInk

#: Where the hand took a dot and where it is now — or nowhere.
Grip := Free | Took Int Int

grip : Grip -> Event -> Grip
grip g e = case e of
    Press x y -> Took x x
    Move x y -> case g of
        Took a b -> Took a x
        Free -> Free
    Release x y -> Free
    Tick -> g
    Key k -> g

aHold : Chan Event
aHold = chan

bHold : Chan Event
bHold = chan

cHold : Chan Event
cHold = chan

aGrip = scanE grip Free (wait aHold)

bGrip = scanE grip Free (wait bHold)

cGrip = scanE grip Free (wait cHold)

#: The row moved: retracted by its key, asserted at the new `x`.
moving : Text -> Int -> List Act
moving k x = retracting dotRel k :: asserting dotRel (k, clampX x) :: Nil

dotPic : Chan Event -> Text -> Dots -> Grip -> Sub
dotPic h k ds g = case g of
    Free -> Shift (xOf ds k) 0 (Holds h Nil (disc k restInk))
    Took a b -> Shift (clampX (xOf ds k + b - a)) 0 (Holds h (moving k (xOf ds k + b - a)) (disc k heldInk))

gather : Grip -> Grip -> Grip -> (Grip, Grip, Grip)
gather a b c = (a, b, c)

grips = !gather aGrip bGrip cGrip

view : (Grip, Grip, Grip) -> Dots -> Sub
view gs ds = case gs of
    (a, b, c) -> Over track (Over (dotPic aHold "a" ds a) (Over (dotPic bHold "b" ds b) (dotPic cHold "c" ds c)))

substrate : Sig Sub
substrate = !view grips dots

#: Silence — the window plays every file it opens.
sound : Sig Float
sound = 0.0
